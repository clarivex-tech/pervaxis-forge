{
  "ConnectionStrings": {
    "ForgeDb": "Host=localhost;Database=forge;Username=postgres;Password=postgres"
  },
  "Forge": {
    "EnableSwagger": false,
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4201" ],
    "DataProtection": {
      "Enabled": false,
      "Prefix": "/Pervaxis/Forge/DataProtection",
      "KmsKeyId": ""
    }
  },
  "Logging": {
    "LogLevel": { "Default": "Information" }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "CloudWatch": {
      "LogGroup": "/pervaxis/forge-api",
      "LogStreamPrefix": "forge-api"
    }
  },
  "Resilience": {
    "Default": {
      "MaxRetryAttempts": 3,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerSamplingWindowSeconds": 30,
      "CircuitBreakerBreakDurationSeconds": 60,
      "TimeoutSeconds": 30
    },
    "GitHub": {
      "MaxRetryAttempts": 3,
      "CircuitBreakerFailureThreshold": 3,
      "CircuitBreakerSamplingWindowSeconds": 60,
      "CircuitBreakerBreakDurationSeconds": 120,
      "TimeoutSeconds": 15
    },
    "Internal": {
      "MaxRetryAttempts": 2,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerSamplingWindowSeconds": 30,
      "CircuitBreakerBreakDurationSeconds": 60,
      "TimeoutSeconds": 10
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "GitHub": {
    "BaseUrl": "https://api.github.com"
  }
}
