# Stage 1: Build
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
# --ignore-scripts: dependency install scripts never run during the image build.
RUN npm ci --ignore-scripts
COPY . .
RUN npm run build:prod

# Stage 2: Serve. nginx-unprivileged runs as a non-root user and listens on 8080.
FROM nginxinc/nginx-unprivileged:alpine AS production
COPY --from=build /app/dist/{{ model.manifest.service_name }}/browser /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
