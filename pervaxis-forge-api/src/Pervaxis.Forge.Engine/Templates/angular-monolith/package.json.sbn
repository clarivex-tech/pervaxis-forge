{
  "name": "{{ model.manifest.service_name }}",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/domain-tool.mjs && ng build",
    "test": "node scripts/domain-tool.mjs && ng test",
    "lint": "node scripts/domain-tool.mjs && ng lint",
    "build:prod": "node scripts/domain-tool.mjs && ng build --configuration production",
    "domains:prepare": "node scripts/domain-tool.mjs",
    "test:architecture": "node --test scripts/domain-tool.spec.mjs"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
{{ if model.manifest.ui_targets | array.contains "mobile" }}
    "@ionic/angular": "^8.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/preferences": "^6.0.0",
{{ end }}
{{ if model.angular_cognito_enabled }}
    "oauth4webapi": "3.8.8",
{{ end }}
{{ if model.angular_cognito_enabled && model.web_admin_layout }}
    "ag-grid-angular": "~36.3.0",
    "ag-grid-community": "~36.3.0",
{{ end }}
    "primeng": "^21.0.0",
    "primeicons": "^7.0.0",
    "@primeng/themes": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "semver": "^7.7.0",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-eslint/builder": "^21.0.0",
    "@angular-eslint/eslint-plugin": "^21.0.0",
    "@angular-eslint/eslint-plugin-template": "^21.0.0",
    "@angular-eslint/template-parser": "^21.0.0",
{{ if model.manifest.ui_targets | array.contains "mobile" }}
    "@capacitor/cli": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
{{ end }}
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "angular-eslint": "^21.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0",
    "jasmine-core": "~5.4.0",
    "@types/jasmine": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.0"
  }
}
