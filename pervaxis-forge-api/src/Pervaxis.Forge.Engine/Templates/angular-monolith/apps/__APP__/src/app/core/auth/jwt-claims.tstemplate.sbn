export type JwtClaims = Readonly<Record<string, unknown>>;

const EMPTY_CLAIMS: JwtClaims = Object.freeze({});

/**
 * Reads the payload of an access token for DISPLAY and UI decisions only (roles, tenant).
 *
 * This does not validate the token: the API validates every access token (signature, issuer,
 * token_use, client) and remains the only authority for what a user may do. An access token that
 * is not a JWT yields no claims.
 */
export function readJwtClaims(token: string): JwtClaims {
  const parts = token.split('.');
  if (parts.length !== 3) {
    return EMPTY_CLAIMS;
  }

  try {
    const base64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');
    const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');
    const bytes = Uint8Array.from(atob(padded), (char) => char.charCodeAt(0));
    const payload: unknown = JSON.parse(new TextDecoder().decode(bytes));
    return typeof payload === 'object' && payload !== null && !Array.isArray(payload)
      ? Object.freeze(payload as Record<string, unknown>)
      : EMPTY_CLAIMS;
  } catch {
    return EMPTY_CLAIMS;
  }
}

/** A claim holding a list of strings (for example cognito:groups). Anything else yields an empty list. */
export function readStringList(value: unknown): readonly string[] {
  if (Array.isArray(value)) {
    return value.filter((item): item is string => typeof item === 'string' && item.length > 0);
  }
  return [];
}

export function readString(value: unknown): string | null {
  return typeof value === 'string' && value.length > 0 ? value : null;
}
