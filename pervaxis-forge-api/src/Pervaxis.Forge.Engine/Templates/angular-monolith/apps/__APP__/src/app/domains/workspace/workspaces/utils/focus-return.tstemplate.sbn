/**
 * Remembers the element that opened a drawer or dialog so focus can return to it when the overlay
 * closes. When that element no longer exists (for example its row was deleted), a fallback runs.
 */
export class FocusReturn {
  private target: HTMLElement | null = null;

  capture(document: Document): void {
    const active = document.activeElement;
    this.target = active instanceof HTMLElement && active !== document.body ? active : null;
  }

  /** Forgets the remembered element without moving focus. */
  clear(): void {
    this.target = null;
  }

  restore(fallback?: () => void): void {
    const target = this.target;
    this.target = null;
    if (target?.isConnected) {
      target.focus();
    } else {
      fallback?.();
    }
  }
}
{{ end }}
