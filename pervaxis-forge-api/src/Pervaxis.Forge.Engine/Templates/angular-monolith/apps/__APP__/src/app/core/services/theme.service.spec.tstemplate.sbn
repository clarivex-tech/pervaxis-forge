import { TestBed } from '@angular/core/testing';
import { ThemeService } from './theme.service';

describe('ThemeService', () => {
  beforeEach(() => localStorage.removeItem('pervaxis.appearance'));
  afterEach(() => { TestBed.resetTestingModule(); localStorage.removeItem('pervaxis.appearance'); document.documentElement.classList.remove('dark-mode'); document.documentElement.style.removeProperty('color-scheme'); });
  it('uses the same dark selector for custom tokens and PrimeNG', () => {
    const theme = TestBed.inject(ThemeService); theme.setPreference('dark');
    expect(document.documentElement.classList.contains('dark-mode')).toBeTrue();
    expect(document.documentElement.style.colorScheme).toBe('dark');
    theme.setPreference('light'); expect(document.documentElement.classList.contains('dark-mode')).toBeFalse();
  });
  it('restores a preference and falls back to system for invalid stored values', () => {
    localStorage.setItem('pervaxis.appearance', 'dark');
    const theme = TestBed.inject(ThemeService); expect(theme.preference()).toBe('dark');
    theme.setPreference('invalid'); expect(theme.preference()).toBe('system');
    expect(theme.dark()).toBe(matchMedia('(prefers-color-scheme: dark)').matches);
  });
});
{{ end }}
