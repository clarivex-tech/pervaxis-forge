{{ if model.angular_cognito_enabled && model.web_admin_layout }}
:host { display: block; }

.task-editor { display: grid; gap: 1.25rem; }
.task-editor h2 { margin: 0; font-size: 1.25rem; }
.field { display: grid; gap: 0.4rem; }
.field label { font-weight: 600; }
.field label span, .field small { color: var(--color-text-muted); }
.field input, .field textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 0.7rem 0.8rem;
  border: 1px solid var(--color-border);
  border-radius: 0.5rem;
  color: var(--color-text);
  background: var(--color-surface);
  font: inherit;
}
.field input:focus-visible, .field textarea:focus-visible,
.editor-actions :focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
.field textarea { resize: vertical; }
.field-error { color: var(--color-danger) !important; }
.editor-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
{{ end }}
