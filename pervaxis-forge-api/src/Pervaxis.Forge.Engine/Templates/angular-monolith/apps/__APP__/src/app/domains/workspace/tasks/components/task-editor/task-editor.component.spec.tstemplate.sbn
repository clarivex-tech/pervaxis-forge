import { TestBed } from '@angular/core/testing';
import { TaskEditorComponent } from './task-editor.component';

describe('TaskEditorComponent', () => {
  it('rejects whitespace-only and over-limit values and trims a valid title', () => {
    TestBed.configureTestingModule({ imports: [TaskEditorComponent] });
    const fixture = TestBed.createComponent(TaskEditorComponent);
    const component = fixture.componentInstance;
    const save = jasmine.createSpy('save');

    component.saveDraft.subscribe(save);
    component.form.controls.title.setValue('   ');
    component.submit();
    expect(save).not.toHaveBeenCalled();

    component.form.controls.title.setValue('x'.repeat(201));
    component.submit();
    expect(save).not.toHaveBeenCalled();

    component.form.controls.title.setValue('  valid title  ');
    component.form.controls.description.setValue('x'.repeat(4_001));
    component.submit();
    expect(save).not.toHaveBeenCalled();

    component.form.controls.description.setValue('');
    component.submit();
    expect(save).toHaveBeenCalledOnceWith({ title: 'valid title', description: null });
  });
});
{{ end }}
