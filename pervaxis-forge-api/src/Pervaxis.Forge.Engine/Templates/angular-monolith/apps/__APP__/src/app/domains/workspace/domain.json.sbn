{{ if model.angular_cognito_enabled && model.web_admin_layout }}
{
  "contractVersion": 1,
  "security": "cognito-tenant",
  "id": "workspace",
  "displayName": "My Workspace",
  "icon": "pi pi-check-square",
  "navigationPath": "tasks",
  "supportedTargets": ["web"],
  "permissions": [],
  "requirements": {
    "packages": {
      "@angular/common": "^21.0.0",
      "@angular/core": "^21.0.0",
      "@angular/forms": "^21.0.0",
      "@angular/router": "^21.0.0",
      "primeng": "^21.0.0",
      "rxjs": "^7.8.0"
    },
    "configuration": ["apiPath"]
  }
}
{{ end }}
