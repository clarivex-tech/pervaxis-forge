import { Provider, inject } from '@angular/core';
import { MessageService } from 'primeng/api';
import { DOMAIN_OPTIONS } from '@forge/ui-contracts/v1';
import { WORKSPACE_RECORDS_MOCK_MODE, WORKSPACE_RECORDS_MODE_OPTION } from '../constants/workspace-record.constants';
import { WorkspaceRecordsState } from '../state/workspace-records.state';
import { MockWorkspaceRecordsData } from './mock-workspace-records.data';
import { UnconfiguredWorkspaceRecordsData } from './unconfigured-workspace-records.data';
import { WorkspaceRecordsData } from './workspace-records.data';

/**
 * Route-scoped providers for the Workspaces screen. Mock data is chosen only when the public domain
 * option `workspaceRecordsMode` is exactly `mock`. Any other value selects a data source that fails
 * visibly, so mock data can never mask a missing API or an authentication failure.
 */
export function provideWorkspaceRecords(): Provider[] {
  return [
    MockWorkspaceRecordsData,
    UnconfiguredWorkspaceRecordsData,
    {
      provide: WorkspaceRecordsData,
      useFactory: (): WorkspaceRecordsData => inject(DOMAIN_OPTIONS)[WORKSPACE_RECORDS_MODE_OPTION] === WORKSPACE_RECORDS_MOCK_MODE
        ? inject(MockWorkspaceRecordsData)
        : inject(UnconfiguredWorkspaceRecordsData),
    },
    MessageService,
    WorkspaceRecordsState,
  ];
}
{{ end }}
