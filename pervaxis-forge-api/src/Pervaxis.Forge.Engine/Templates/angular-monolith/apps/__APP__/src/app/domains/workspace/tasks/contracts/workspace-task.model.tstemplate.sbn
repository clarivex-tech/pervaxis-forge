export interface WorkspaceTask {
  readonly id: string;
  readonly title: string;
  readonly description: string | null;
  readonly isCompleted: boolean;
  readonly createdAt: string;
  readonly updatedAt: string;
  readonly version: string;
}

export interface WorkspaceTaskPage {
  readonly items: readonly WorkspaceTask[];
  readonly page: number;
  readonly pageSize: number;
  readonly hasMore: boolean;
}

export interface WorkspaceTaskDraft {
  readonly title: string;
  readonly description: string | null;
}

export interface CreateWorkspaceTaskRequest extends WorkspaceTaskDraft {
  readonly isCompleted?: false;
}

export interface UpdateWorkspaceTaskRequest extends WorkspaceTaskDraft {
  readonly isCompleted: boolean;
}

export interface VersionedWorkspaceTask {
  readonly task: WorkspaceTask;
  readonly etag: string;
}
{{ end }}
