import { ChangeDetectionStrategy, Component, inject, OnInit, signal } from '@angular/core';
import { CommonModule } from '@angular/common';
import { ReactiveFormsModule, FormBuilder, FormGroup, Validators } from '@angular/forms';
{{ if model.manifest.ui_targets | array.contains "mobile" }}
import { ActivatedRoute } from '@angular/router';
import { NavController } from '@ionic/angular/standalone';
{{ else }}
import { ActivatedRoute, Router } from '@angular/router';
{{ end }}
import { SampleService } from '../../services/sample.service';

@Component({
  selector: '{{ model.manifest.component_prefix }}-sample-form',
  standalone: true,
  imports: [CommonModule, ReactiveFormsModule],
  templateUrl: './sample-form.component.html',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class SampleFormComponent implements OnInit {
  private readonly fb = inject(FormBuilder);
  private readonly route = inject(ActivatedRoute);
{{ if model.manifest.ui_targets | array.contains "mobile" }}
  private readonly navCtrl = inject(NavController);
{{ else }}
  private readonly router = inject(Router);
{{ end }}
  private readonly sampleService = inject(SampleService);

  readonly isEditMode = signal<boolean>(false);
  readonly loading = signal<boolean>(false);
  private itemId: number | null = null;

  readonly form: FormGroup = this.fb.group({
    name: ['', [Validators.required, Validators.minLength(3)]],
    description: [''],
    status: ['active', [Validators.required]],
  });

  ngOnInit(): void {
    const id = this.route.snapshot.paramMap.get('id');
    if (id) {
      this.isEditMode.set(true);
      this.itemId = Number(id);
      this.loadItem(this.itemId);
    }
  }

  private loadItem(id: number): void {
    this.loading.set(true);
    this.sampleService.getById(id).subscribe({
      next: (item) => {
        this.form.patchValue({
          name: item.name,
          description: item.description,
          status: item.status,
        });
        this.loading.set(false);
      },
      error: () => {
        this.loading.set(false);
      },
    });
  }

  onSubmit(): void {
    if (this.form.invalid) {
      this.form.markAllAsTouched();
      return;
    }

    const formValue = this.form.getRawValue();

    if (this.isEditMode() && this.itemId !== null) {
      this.sampleService.update(this.itemId, formValue).subscribe({
        next: () => this.navigateToList(),
      });
    } else {
      this.sampleService.create(formValue).subscribe({
        next: () => this.navigateToList(),
      });
    }
  }

  onCancel(): void {
    this.navigateToList();
  }

  private navigateToList(): void {
{{ if model.manifest.ui_targets | array.contains "mobile" }}
    this.navCtrl.navigateBack('../');
{{ else }}
    this.router.navigate(['../'], { relativeTo: this.route });
{{ end }}
  }
}
