import { Component, OnInit, inject, signal } from '@angular/core';
import { ActivatedRoute, Router } from '@angular/router';
import { AuthService, sanitizeReturnUrl } from '../../core/auth/auth.service';
import { LoggerService } from '../../core/services/logger.service';

const MESSAGES: Readonly<Record<string, string>> = {
  session_ended: 'Your session has ended. Please sign in again.',
  signed_out: 'You have been signed out.',
  provider_error: 'Sign-in was cancelled or was not allowed.',
};
const DEFAULT_ERROR = 'Sign-in did not complete. Please try again.';

/**
 * HORIZONTAL: Public sign-in page. "Sign in" redirects to the Cognito hosted UI
 * (authorization code + PKCE). There is no password form in the app and no mock sign-in.
 * When the configuration is missing or invalid, sign-in is unavailable and the problems are listed.
 *
 * VERTICAL: You may restyle this page; keep the AuthService calls.
 */
@Component({
  selector: '{{ model.manifest.component_prefix }}-login',
  standalone: true,
  template: `
    <main class="login-container">
      <div class="login-card">
        <h1 [textContent]="appName"></h1>

        @if (auth.status() === 'unavailable') {
          <div class="login-error" role="alert">
            <p>Sign-in is not available.</p>
            <ul>
              @for (reason of auth.unavailableReasons(); track reason) {
                <li [textContent]="reason"></li>
              }
            </ul>
          </div>
        } @else {
          <p class="login-subtitle">Sign in to continue</p>
          @if (message()) {
            <p class="login-message" role="status" [textContent]="message()"></p>
          }
          @if (error()) {
            <p class="login-error" role="alert" [textContent]="error()"></p>
          }
          <button
            type="button"
            class="btn-primary"
            (click)="signIn()"
            [disabled]="busy() || auth.status() === 'initializing'"
          >Sign in</button>
        }
      </div>
    </main>
  `,
  styles: [`
    .login-container {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      background: #f8fafc;
    }
    .login-card {
      background: white;
      padding: var(--spacing-2xl);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      width: 100%;
      max-width: 400px;
    }
    h1 { margin-bottom: var(--spacing-xs); }
    .login-subtitle { color: var(--color-secondary); margin-bottom: var(--spacing-xl); }
    .login-message { margin-bottom: var(--spacing-md); }
    .login-error { color: #b91c1c; margin-bottom: var(--spacing-md); }
    .btn-primary {
      width: 100%;
      padding: var(--spacing-sm) var(--spacing-md);
      background: var(--color-primary);
      color: white;
      border: none;
      border-radius: var(--radius-md);
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      margin-top: var(--spacing-md);
    }
    .btn-primary:hover { background: var(--color-primary-dark); }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
  `],
})
export class LoginComponent implements OnInit {
  protected readonly auth = inject(AuthService);
  private readonly router = inject(Router);
  private readonly route = inject(ActivatedRoute);
  private readonly logger = inject(LoggerService);

  protected readonly appName = '{{ model.manifest.service_name }}';
  protected readonly busy = signal(false);
  protected readonly message = signal<string | null>(null);
  protected readonly error = signal<string | null>(null);

  private get returnUrl(): string {
    return sanitizeReturnUrl(this.route.snapshot.queryParamMap.get('returnUrl') ?? '/');
  }

  async ngOnInit(): Promise<void> {
    const params = this.route.snapshot.queryParamMap;
    const reason = params.get('reason');
    const errorCode = params.get('error');
    this.message.set(reason ? MESSAGES[reason] ?? null : null);
    this.error.set(errorCode ? MESSAGES[errorCode] ?? DEFAULT_ERROR : null);

    await this.auth.ready;
    if (this.auth.isAuthenticated()) {
      await this.router.navigateByUrl(this.returnUrl, { replaceUrl: true });
    }
  }

  async signIn(): Promise<void> {
    this.busy.set(true);
    this.error.set(null);
    try {
      await this.auth.login(this.returnUrl);
    } catch (error) {
      this.logger.error('Sign-in could not start', error);
      this.error.set(DEFAULT_ERROR);
      this.busy.set(false);
    }
  }
}
