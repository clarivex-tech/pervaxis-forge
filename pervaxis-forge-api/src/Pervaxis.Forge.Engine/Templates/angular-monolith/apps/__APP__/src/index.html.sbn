<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{ model.manifest.service_name }}</title>
    <base href="/" />
{{ if model.manifest.ui_targets | array.contains "mobile" }}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
{{ else }}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
{{ end }}
    <!--
      Content Security Policy:
      - 'unsafe-inline' for style-src is required because Angular uses inline styles
        for component encapsulation (ViewEncapsulation.Emulated). This is a known
        tradeoff documented by the Angular team.
      - If your vertical does NOT use component styles, you can remove 'unsafe-inline'.
      - For stricter CSP, consider using ViewEncapsulation.None with external stylesheets.
      - connect-src allows any https origin (plus localhost for development) because the Cognito
        domain and API URL come from the runtime configuration. In production, send a CSP header
        from the web server that limits connect-src to 'self', the Cognito domain and the API
        origin; browsers enforce both policies. See AUTHENTICATION.md.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'self';"
    />
{{ if model.manifest.ui_targets | array.contains "mobile" }}
    <meta name="color-scheme" content="light dark" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
{{ end }}
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
  </head>
  <body>
    <{{ model.manifest.component_prefix }}-root></{{ model.manifest.component_prefix }}-root>
  </body>
</html>
