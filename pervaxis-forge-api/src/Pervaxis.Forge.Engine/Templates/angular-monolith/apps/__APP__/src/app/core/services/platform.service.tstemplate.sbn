{{ if model.manifest.ui_targets | array.contains "mobile" }}
import { Injectable } from '@angular/core';
import { Capacitor } from '@capacitor/core';

@Injectable({ providedIn: 'root' })
export class PlatformService {
  /**
   * Returns true when the app is running inside a Capacitor native shell
   * (Android/iOS), false when running in a standard browser.
   */
  get isNative(): boolean {
    return Capacitor.isNativePlatform();
  }

  /**
   * Returns the current platform: 'ios', 'android', or 'web'.
   */
  get platform(): string {
    return Capacitor.getPlatform();
  }
}
{{ else }}
import { Injectable } from '@angular/core';

/**
 * PlatformService — web-only stub.
 *
 * Detects whether the app is running in a browser context.
 * When the mobile target is added (uiTargets includes "mobile"),
 * this service is replaced with a Capacitor-backed implementation.
 */
@Injectable({ providedIn: 'root' })
export class PlatformService {
  /** Always false for web-only builds. */
  get isNative(): boolean {
    return false;
  }

  /** Always returns 'web' for web-only builds. */
  get platform(): string {
    return 'web';
  }
}
{{ end }}
