{{ if model.angular_cognito_enabled && model.web_admin_layout }}
:host { display: flex; flex-direction: column; flex: 1 1 auto; color: var(--color-text); }
.form { display: flex; flex-direction: column; flex: 1 1 auto; }
.form__body { flex: 1 1 auto; padding: 1.25rem; }
.form__footer {
  position: sticky; bottom: 0; display: flex; justify-content: flex-end; gap: 0.5rem; padding: 0.75rem 1.25rem;
  border-top: 1px solid var(--color-border); background: var(--color-surface-hover);
}
.form__legend-note { margin: 0 0 1rem; color: var(--color-text-muted); font-size: 0.85rem; }
.required-mark { color: var(--color-danger); font-weight: 700; }
.optional { color: var(--color-text-muted); font-weight: 400; }
.group { border: 0; padding: 0; margin: 0 0 1.25rem; min-width: 0; }
.group legend { padding: 0; margin-bottom: 0.65rem; font-weight: 700; }
.row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
.field { display: flex; flex-direction: column; gap: 0.3rem; margin-bottom: 1rem; min-width: 0; }
.field label { font-weight: 600; }
.field input, .field textarea, .field p-select { width: 100%; }
.field textarea { resize: vertical; }
.hint { color: var(--color-text-muted); font-size: 0.8rem; }
.error { display: none; color: var(--color-danger); font-size: 0.8rem; font-weight: 600; }
.field--invalid .error { display: block; }
.field--invalid input, .field--invalid textarea { border-color: var(--color-danger); }
.error-summary {
  margin: 0 0 1.25rem; padding: 0.75rem 1rem; border: 1px solid var(--color-danger-border); border-radius: 0.5rem;
  background: var(--color-danger-bg); color: var(--color-danger);
}
.error-summary__title { margin: 0; font-weight: 700; }
.error-summary__reference { margin: 0.25rem 0 0; font-size: 0.85rem; }
.error-summary__list { margin: 0.5rem 0 0; padding-left: 1.1rem; }
.link-button { padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left; text-decoration: underline; cursor: pointer; }
.sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
:host :focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
@media (max-width: 640px) {
  .row { grid-template-columns: 1fr; }
  .form__footer { flex-direction: column-reverse; }
  .form__footer p-button { width: 100%; }
}
{{ end }}
