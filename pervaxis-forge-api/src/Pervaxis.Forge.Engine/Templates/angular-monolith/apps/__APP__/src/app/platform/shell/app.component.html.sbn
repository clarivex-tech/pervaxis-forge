@if (confirmDialog()) {
  <div class="confirm-overlay" (click)="onConfirmCancel()" (keydown.escape)="onConfirmCancel()" role="dialog" aria-modal="true" tabindex="-1">
    <div class="confirm-dialog" role="presentation" (click)="$event.stopPropagation()" (keydown)="$event.stopPropagation()">
      <h3 [textContent]="confirmDialog()?.title"></h3>
