      <div class="confirm-actions">
        <button pRipple class="btn" (click)="onConfirmCancel()" [textContent]="confirmDialog()?.cancelLabel || 'Cancel'"></button>
        <button pRipple class="btn" [class.btn--danger]="confirmDialog()?.destructive" (click)="onConfirmOk()" [textContent]="confirmDialog()?.confirmLabel || 'Confirm'"></button>
      </div>
    </div>
  </div>
}

<!-- Web shell: platform-owned layout, feature routes remain lazy and independently guarded. -->
<a class="skip-link" href="#main-content" (click)="skipToContent($event)">Skip to main content</a>
<ng-template #navigation>
  <nav class="app-sidebar__nav" aria-label="Main navigation">
    <span class="navigation-heading">WORKSPACE</span>
    @for (item of menuItems(); track item.routerLink) {
      <a [routerLink]="item.routerLink" routerLinkActive="active" ariaCurrentWhenActive="page"
         [attr.aria-label]="item.label" [title]="item.label" class="sidebar-item" pRipple
         (click)="closeNavigation()">
        <i [class]="item.icon" aria-hidden="true"></i><span [textContent]="item.label"></span>
      </a>
    }
{{ if model.angular_cognito_enabled }}
    @if (auth.roles().includes('PlatformAdmin')) {
      <span class="navigation-heading">ADMINISTRATION</span>
      <a routerLink="/admin/tenants" routerLinkActive="active" ariaCurrentWhenActive="page"
         aria-label="Tenants and users" title="Tenants and users" class="sidebar-item" pRipple
         (click)="closeNavigation()">
        <i class="pi pi-building" aria-hidden="true"></i><span>Tenants and users</span>
      </a>
    }
{{ end }}
  </nav>
</ng-template>
{{ if model.angular_cognito_enabled }}
@if (auth.isAuthenticated()) {
{{ end }}
<p-drawer [visible]="mobileNavigationOpen()" (visibleChange)="navigationVisibilityChanged($event)" header="Navigation" styleClass="app-navigation-drawer" [modal]="true" [dismissible]="true"
          [closeOnEscape]="true" [blockScroll]="true" (onShow)="focusNavigation()" (onHide)="closeNavigation(true)">
  <ng-container [ngTemplateOutlet]="navigation" />
</p-drawer>
{{ if model.angular_cognito_enabled }}
}
{{ end }}
<div class="app-layout" {{ if model.angular_cognito_enabled }}[class.app-layout--public]="!auth.isAuthenticated()"{{ end }} [class.sidebar-collapsed]="sidebarCollapsed()">
{{ if model.angular_cognito_enabled }}
  @if (auth.isAuthenticated()) {
{{ end }}
  <header class="app-header">
    <p-toolbar [style]="{ border: '0', borderRadius: '0', gap: '0.75rem', padding: '0.75rem 1rem', background: 'var(--color-header-bg)', color: 'var(--color-header-text)' }">
      <ng-template #start>
        <button pRipple id="navigation-toggle" type="button" class="navigation-toggle" (click)="toggleSidebar()"
                [attr.aria-label]="narrowScreen() ? 'Open navigation' : sidebarCollapsed() ? 'Expand navigation' : 'Collapse navigation'"
                [attr.aria-expanded]="narrowScreen() ? mobileNavigationOpen() : !sidebarCollapsed()">
          <i class="pi pi-bars" aria-hidden="true"></i>
        </button>
        <span class="app-header__brand" [textContent]="title"></span>
      </ng-template>
      <ng-template #end>
{{ if model.angular_cognito_enabled }}
        @if (auth.isAuthenticated()) {
          <div class="app-header__identity">
            <span class="app-header__user" [textContent]="auth.profile()?.displayName ?? ''"></span>
          </div>
          <p-menu #accountMenu [id]="'user-account-menu'" [model]="userMenuItems" [popup]="true" appendTo="body" ariaLabel="User menu" />
          <button pRipple id="user-menu-toggle" type="button" class="navigation-toggle" title="Account" aria-label="Open user menu" aria-haspopup="menu"
                  aria-controls="user-account-menu" [attr.aria-expanded]="accountMenu.visible === true" (click)="accountMenu.toggle($event)">
            <i class="pi pi-user" aria-hidden="true"></i>
          </button>
{{ if model.angular_cognito_enabled }}
        }
{{ end }}
{{ end }}
      </ng-template>
    </p-toolbar>
  </header>
  <aside class="app-sidebar"><ng-container [ngTemplateOutlet]="navigation" /></aside>
{{ if model.angular_cognito_enabled }}
  }
{{ end }}
  <main class="app-content" id="main-content" tabindex="-1"><router-outlet /></main>
</div>
{{ end }}

{{ end }}
