import { Observable } from 'rxjs';
import {
  WorkspaceAuditEvent, WorkspaceDraft, WorkspaceExportResult, WorkspaceFieldErrors, WorkspaceMember,
  WorkspaceRecord, WorkspaceStatus,
} from '../contracts/workspace-record.model';

/**
 * Data port for the Workspaces CRUDA screen. The screen only talks to this contract, so a real API
 * client can replace the mock without touching components or state. No API client exists yet.
 */
export abstract class WorkspaceRecordsData {
  /** Identifies where records come from so the UI can label non-live data. */
  abstract readonly source: 'mock' | 'unconfigured';
  abstract list(): Observable<readonly WorkspaceRecord[]>;
  abstract create(draft: WorkspaceDraft): Observable<WorkspaceRecord>;
  abstract update(id: string, draft: WorkspaceDraft): Observable<WorkspaceRecord>;
  abstract setStatus(ids: readonly string[], status: WorkspaceStatus): Observable<readonly WorkspaceRecord[]>;
  abstract remove(ids: readonly string[]): Observable<void>;
  abstract restore(ids: readonly string[]): Observable<readonly WorkspaceRecord[]>;
  abstract members(id: string): Observable<readonly WorkspaceMember[]>;
  abstract audit(id: string): Observable<readonly WorkspaceAuditEvent[]>;
  abstract exportRecords(ids: readonly string[] | null): Observable<WorkspaceExportResult>;
}

/** Failure raised by a data source. `referenceCode` is safe to show to users and support. */
export class WorkspaceRecordsError extends Error {
  constructor(
    message: string,
    readonly status: number,
    readonly referenceCode: string,
    readonly fieldErrors: WorkspaceFieldErrors = {},
  ) {
    super(message);
    this.name = 'WorkspaceRecordsError';
  }
}
{{ end }}
