import { DestroyRef, InjectionToken, Signal } from '@angular/core';
import { Routes } from '@angular/router';
import { Observable } from 'rxjs';

export const UI_CONTRACT_MAJOR = 1 as const;

export interface UiDomainManifestV1 {
  readonly contractVersion: 1;
  readonly security: 'cognito-tenant' | 'public';
  readonly id: string;
  readonly displayName: string;
  readonly icon: string;
  /** Optional route beneath the domain root used by the generated navigation item. */
  readonly navigationPath?: string;
  readonly supportedTargets: readonly ('web' | 'mobile')[];
  readonly permissions: readonly string[];
  readonly requirements: {
    readonly packages: Readonly<Record<string, string>>;
    readonly configuration: readonly string[];
  };
}

/** Host wiring generated at build time; routes stay in lazy chunks. */
export interface UiDomainRegistrationV1 {
  readonly manifest: UiDomainManifestV1;
  readonly options: Readonly<Record<string, unknown>>;
  readonly loadRoutes: () => Promise<Routes>;
}

export interface DomainHttpV1 {
  get<T>(path: string, params?: Record<string, string>): Observable<T>;
  post<T>(path: string, body: unknown): Observable<T>;
  put<T>(path: string, body: unknown): Observable<T>;
  patch<T>(path: string, body: unknown): Observable<T>;
  delete<T>(path: string): Observable<T>;
  getResponse<T>(path: string, params?: Record<string, string>): Observable<DomainHttpResponseV1<T>>;
  postResponse<T>(path: string, body: unknown): Observable<DomainHttpResponseV1<T>>;
  putResponse<T>(path: string, body: unknown, headers?: Readonly<Record<string, string>>): Observable<DomainHttpResponseV1<T>>;
  deleteResponse<T>(path: string, headers?: Readonly<Record<string, string>>): Observable<DomainHttpResponseV1<T>>;
}

/** Transport-neutral response metadata for portable conditional API operations. */
export interface DomainHttpResponseV1<T> {
  readonly body: T | null;
  readonly status: number;
  header(name: string): string | null;
}

export type DomainSessionResetReasonV1 = 'signed-out' | 'session-ended' | 'tenant-changed' | 'identity-changed';
export interface DomainSessionStateV1 {
  registerUntilDestroyed(destroyRef: DestroyRef, listener: (reason: DomainSessionResetReasonV1) => void): void;
}
export interface DomainIdentityV1 {
  readonly isAuthenticated: Signal<boolean>;
  readonly roles: Signal<readonly string[]>;
  readonly tenantId: Signal<string | null>;
  readonly identityId: Signal<string | null>;
}

export const DOMAIN_HTTP = new InjectionToken<DomainHttpV1>('forge.ui.v1.http');
export const DOMAIN_SESSION_STATE = new InjectionToken<DomainSessionStateV1>('forge.ui.v1.session-state');
export const DOMAIN_IDENTITY = new InjectionToken<DomainIdentityV1>('forge.ui.v1.identity');
/** Route-scoped public options from the copied domain.config.json. Never store secrets here. */
export const DOMAIN_OPTIONS = new InjectionToken<Readonly<Record<string, unknown>>>('forge.ui.v1.options');
export const DOMAIN_REGISTRATIONS = new InjectionToken<readonly UiDomainRegistrationV1[]>(
  'forge.ui.v1.registrations', { providedIn: 'root', factory: () => [] });
