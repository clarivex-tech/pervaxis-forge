import { CanActivateFn, Router } from '@angular/router';
import { inject } from '@angular/core';
import { AuthService } from '../auth/auth.service';

/**
 * HORIZONTAL: Requires a signed-in user. Waits for session restore after a reload, then redirects
 * to /login (keeping the requested URL) when there is no usable session.
 *
 * Public routes (login, auth/callback, access-denied, not-found) must not use this guard.
 */
export const authGuard: CanActivateFn = async (_route, state) => {
  const auth = inject(AuthService);
  const router = inject(Router);

  if (await auth.ensureSession()) {
    return true;
  }
  return router.createUrlTree(['/login'], { queryParams: { returnUrl: state.url } });
};
