import { CanActivateFn, Router } from '@angular/router';
import { inject } from '@angular/core';
import { AuthService } from '../auth/auth.service';
import { LoggerService } from '../services/logger.service';

/**
 * HORIZONTAL: Permission-based route guard factory.
 *
 * Usage in routes:
 *   { path: 'admin', canActivate: [permissionGuard('Admin')], ... }
 *
 * Permissions come from the access token's role claim (default cognito:groups) via
 * AuthService.hasPermission(). This only hides UI the user cannot use; the API enforces the
 * same rule on every request. Signed-out users go to /login, others without the permission
 * to /access-denied.
 */
export function permissionGuard(requiredPermission: string): CanActivateFn {
  return async (_route, state) => {
    const auth = inject(AuthService);
    const router = inject(Router);
    const logger = inject(LoggerService);

    if (!(await auth.ensureSession())) {
      return router.createUrlTree(['/login'], { queryParams: { returnUrl: state.url } });
    }

    if (auth.hasPermission(requiredPermission)) {
      return true;
    }
    logger.warn(`Permission guard: missing permission '${requiredPermission}'`);
    return router.createUrlTree(['/access-denied'], { queryParams: { reason: 'permission' } });
  };
}
