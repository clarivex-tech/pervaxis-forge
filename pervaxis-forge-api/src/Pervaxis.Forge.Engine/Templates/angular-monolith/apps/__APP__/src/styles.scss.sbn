@use 'primeicons/primeicons.css';

/* CSS Reset */
*,
*::before,
*::after {
  box-sizing: border-box;
}

* {
  margin: 0;
  padding: 0;
}

{{ if model.manifest.ui_targets | array.contains "mobile" }}
/* Safe-area tokens for iOS notch / Android punch-hole */
:root {
  --safe-area-top: env(safe-area-inset-top);
  --safe-area-bottom: env(safe-area-inset-bottom);
  --safe-area-left: env(safe-area-inset-left);
  --safe-area-right: env(safe-area-inset-right);
}
{{ end }}

html,
body {
  height: 100%;
  font-family: var(--font-family-base);
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

img,
picture,
video,
canvas,
svg {
  display: block;
  max-width: 100%;
}

input,
button,
textarea,
select {
  font: inherit;
}

/* Design Tokens */
:root {
{{ if model.web_admin_layout }}
  --color-primary: var(--p-primary-color);
  --color-primary-dark: var(--p-primary-hover-color);
  --color-primary-light: var(--p-highlight-background);
  --color-primary-contrast: var(--p-primary-contrast-color);
  --color-header-bg: var(--p-indigo-950);
  --color-header-border: var(--p-indigo-900);
  --color-header-text: var(--p-indigo-50);
  --color-header-muted: var(--p-indigo-200);
  --color-header-hover: var(--p-indigo-900);
  --color-header-focus: var(--p-indigo-200);
  --color-sidebar-bg: var(--p-indigo-50);
  --color-sidebar-border: var(--p-indigo-100);
  --color-sidebar-text: var(--p-indigo-950);
  --color-sidebar-muted: var(--p-indigo-700);
  --color-sidebar-hover: var(--p-indigo-100);
  --color-sidebar-active-bg: var(--p-indigo-100);
  --color-sidebar-active-text: var(--p-indigo-800);
  --color-sidebar-active-icon: var(--p-indigo-700);
  --color-secondary: var(--p-text-muted-color);
  --color-success: var(--p-green-800);
  --color-success-bg: var(--p-green-50);
  --color-success-border: var(--p-green-200);
  --color-warning: var(--p-amber-800);
  --color-warning-bg: var(--p-amber-50);
  --color-warning-border: var(--p-amber-200);
  --color-danger: var(--p-red-800);
  --color-danger-bg: var(--p-red-50);
  --color-danger-border: var(--p-red-200);
  --color-info: var(--p-blue-800);
  --color-info-bg: var(--p-blue-50);
  --color-info-border: var(--p-blue-200);

  --color-bg: var(--p-slate-50);
  --color-surface: var(--p-content-background);
  --color-surface-hover: var(--p-content-hover-background);
  --color-border: var(--p-content-border-color);
  --color-text: var(--p-text-color);
  --color-text-muted: var(--p-text-muted-color);
{{ else }}
  --color-primary: #3b82f6;
  --color-primary-dark: #2563eb;
  --color-primary-light: #93c5fd;
  --color-secondary: #64748b;
  --color-success: #22c55e;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;

  --color-bg: #ffffff;
  --color-surface: #f9fafb;
  --color-border: #e5e7eb;
  --color-text: #1f2937;
  --color-text-muted: #6b7280;
{{ end }}

  --font-family-base: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
    Oxygen, Ubuntu, Cantarell, sans-serif;
  --font-family-mono: 'Fira Code', 'Cascadia Code', Consolas, monospace;

  --spacing-xs: 0.25rem;
  --spacing-sm: 0.5rem;
  --spacing-md: 1rem;
  --spacing-lg: 1.5rem;
  --spacing-xl: 2rem;
  --spacing-2xl: 3rem;

  --radius-sm: 0.25rem;
  --radius-md: 0.5rem;
  --radius-lg: 0.75rem;
  --radius-full: 9999px;

  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1);
  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1);

  /* Responsive breakpoints (mobile-first) */
  --breakpoint-sm: 640px;
  --breakpoint-md: 768px;
  --breakpoint-lg: 1024px;
  --breakpoint-xl: 1280px;
  --breakpoint-2xl: 1536px;
}

/* Dark Mode — custom design tokens */
{{ if !model.web_admin_layout }}
@media (prefers-color-scheme: dark) {
  :root {
{{ else }}
html.dark-mode {
  & {
{{ end }}
{{ if model.web_admin_layout }}
    --color-primary: var(--p-primary-color);
    --color-primary-dark: var(--p-primary-hover-color);
    --color-primary-light: var(--p-highlight-background);
    --color-primary-contrast: var(--p-primary-contrast-color);
    --color-header-bg: var(--p-indigo-950);
    --color-header-border: var(--p-indigo-900);
    --color-header-text: var(--p-indigo-50);
    --color-header-muted: var(--p-indigo-200);
    --color-header-hover: var(--p-indigo-900);
    --color-header-focus: var(--p-indigo-200);
    --color-sidebar-bg: var(--p-indigo-900);
    --color-sidebar-border: var(--p-indigo-800);
    --color-sidebar-text: var(--p-indigo-100);
    --color-sidebar-muted: var(--p-indigo-300);
    --color-sidebar-hover: var(--p-indigo-800);
    --color-sidebar-active-bg: var(--p-indigo-700);
    --color-sidebar-active-text: var(--p-indigo-50);
    --color-sidebar-active-icon: var(--p-indigo-100);
    --color-secondary: var(--p-text-muted-color);
    --color-success: var(--p-green-200);
    --color-success-bg: var(--p-green-950);
    --color-success-border: var(--p-green-800);
    --color-warning: var(--p-amber-200);
    --color-warning-bg: var(--p-amber-950);
    --color-warning-border: var(--p-amber-800);
    --color-danger: var(--p-red-200);
    --color-danger-bg: var(--p-red-950);
    --color-danger-border: var(--p-red-800);
    --color-info: var(--p-blue-200);
    --color-info-bg: var(--p-blue-950);
    --color-info-border: var(--p-blue-800);

    --color-bg: var(--p-slate-900);
    --color-surface: var(--p-content-background);
    --color-surface-hover: var(--p-content-hover-background);
    --color-border: var(--p-content-border-color);
    --color-text: var(--p-text-color);
    --color-text-muted: var(--p-text-muted-color);
{{ else }}
    --color-primary: #60a5fa;
    --color-primary-dark: #3b82f6;
    --color-primary-light: #1d4ed8;
    --color-secondary: #94a3b8;
    --color-success: #4ade80;
    --color-warning: #fbbf24;
    --color-danger: #f87171;

    --color-bg: #0f172a;
    --color-surface: #1e293b;
    --color-border: #334155;
    --color-text: #f1f5f9;
    --color-text-muted: #94a3b8;
{{ end }}

    --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
    --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.5);
  }
}

/* Global Loading Bar (horizontal — do not remove) */
.global-loading-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: var(--color-primary);
  z-index: 9999;
  animation: loading-progress 1.5s ease-in-out infinite;
}

@keyframes loading-progress {
  0% { transform: translateX(-100%); }
  50% { transform: translateX(0%); }
  100% { transform: translateX(100%); }
}

/* App Container */
.app-container {
  min-height: 100vh;
}

{{ if model.manifest.ui_targets | array.contains "mobile" }}
/* Ionic Theme Variables */
:root {
  --ion-color-primary: var(--color-primary);
  --ion-color-secondary: var(--color-secondary);
  --ion-color-success: var(--color-success);
  --ion-color-warning: var(--color-warning);
  --ion-color-danger: var(--color-danger);
  --ion-font-family: var(--font-family-base);
}

{{ if model.manifest.ui_targets | array.contains "mobile" }}
@media (prefers-color-scheme: dark) {
  :root {
{{ else }}
html.dark-mode {
  & {
{{ end }}
    --ion-background-color: #1a1a2e;
    --ion-text-color: #ffffff;
  }
}
{{ end }}

/* Print Stylesheet */
@media print {
  .global-loading-bar,
  nav,
  aside,
  footer,
  button,
  [aria-hidden="true"] {
    display: none !important;
  }

  body {
    font-size: 12pt;
    color: #000;
    background: #fff;
  }

  a[href]::after {
    content: " (" attr(href) ")";
    font-size: 0.8em;
    color: #555;
  }

  * {
    box-shadow: none !important;
  }
}

{{ if model.web_admin_layout }}
:root { color: var(--color-text); background: var(--color-bg); }
.app-header {
  background: var(--color-header-bg);
  color: var(--color-header-text);
  border-bottom: 1px solid var(--color-header-border);
}
.app-header__brand, .app-header__user { color: var(--color-header-text); }
.app-header__tenant { color: var(--color-header-muted); }
.app-header :focus-visible { outline-color: var(--color-header-focus); }
.navigation-toggle { color: var(--color-header-text); }
.navigation-toggle:hover { background: var(--color-header-hover); }
.app-sidebar {
  border-inline-end: 1px solid var(--color-sidebar-border);
  background: var(--color-sidebar-bg);
}
.navigation-heading { color: var(--color-sidebar-muted); }
.sidebar-item { color: var(--color-sidebar-text); }
.sidebar-item:hover, .sidebar-item:focus-visible { background: var(--color-sidebar-hover); }
.sidebar-item.active {
  color: var(--color-sidebar-active-text);
  background: var(--color-sidebar-active-bg);
  font-weight: 700;
}
.sidebar-item i { color: var(--color-sidebar-muted); }
.sidebar-item.active i { color: var(--color-sidebar-active-icon); }
:root .app-navigation-drawer.p-drawer {
  --p-drawer-background: var(--color-sidebar-bg);
  --p-drawer-border-color: var(--color-sidebar-border);
  --p-drawer-color: var(--color-sidebar-text);
}
:root .app-navigation-drawer .p-drawer-close-button { color: var(--color-sidebar-text); }
html:root { --p-ripple-background: color-mix(in srgb, var(--p-primary-color) 16%, transparent); }
html.dark-mode { --p-ripple-background: color-mix(in srgb, var(--p-primary-color) 18%, transparent); }
.p-ripple:disabled .p-ink { display: none !important; }
:focus-visible { outline: 3px solid var(--p-primary-color); outline-offset: 3px; }
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .p-ink { display: none !important; }
}
{{ end }}
