import { Component, DestroyRef, computed, inject, signal, viewChild } from '@angular/core';
import { RouterOutlet, RouterLink, RouterLinkActive } from '@angular/router';
{{ if model.manifest.ui_targets | array.contains "mobile" }}
import { IonApp, IonRouterOutlet, IonProgressBar, IonToast, IonAlert } from '@ionic/angular/standalone';
{{ end }}
{{ if model.web_admin_layout }}
import { DOCUMENT, NgTemplateOutlet } from '@angular/common';
import { NavigationEnd, Router } from '@angular/router';
import { DrawerModule } from 'primeng/drawer';
import { ThemeService } from '../core/services/theme.service';
{{ end }}
import { ToolbarModule } from 'primeng/toolbar';
import { ButtonModule } from 'primeng/button';
import { AvatarModule } from 'primeng/avatar';
import { Menu, MenuModule } from 'primeng/menu';
import { MenuItem } from 'primeng/api';
import { RippleModule } from 'primeng/ripple';
import { DomainNavigationService } from '../domains/domain-runtime';
import { LoadingService } from '../core/services/loading.service';
import { NotificationService } from '../core/services/notification.service';
import { ConfirmDialogService } from '@shared/services/confirm-dialog.service';
import { RouteLoadingService } from '../core/services/route-loading.service';
{{ if model.angular_cognito_enabled }}
import { InactivityService } from '../core/services/inactivity.service';
{{ end }}
{{ if model.angular_cognito_enabled }}
import { AuthService } from '../core/auth/auth.service';
{{ if model.web_admin_layout }}
import { SessionStateRegistry } from '../core/auth/session-state';
{{ end }}
{{ end }}
/**
 * Root application component.
 *
 * HORIZONTAL (do not modify):
 *   - Loading indicator
 *   - Notification toasts
 *   - Confirmation dialog
 *   - App shell layout (header, sidebar)
 *   - Route loading, inactivity detection
 *   - Signed-in user and sign-out in the header (cross-tab sign-out runs in AuthService)
 *
 * Business navigation is generated from domain manifests; keep this shell print-owned.
 */
@Component({
  selector: '{{ model.manifest.component_prefix }}-root',
  standalone: true,
{{ if model.manifest.ui_targets | array.contains "mobile" }}
  imports: [IonApp, IonRouterOutlet, IonProgressBar, IonToast, IonAlert],
{{ else }}
  imports: [RouterOutlet, RouterLink, RouterLinkActive, NgTemplateOutlet, DrawerModule, ToolbarModule, ButtonModule, AvatarModule, MenuModule, RippleModule],
{{ end }}
  templateUrl: './app.component.html',
  styleUrls: ['./app.component.scss'],
})
export class AppComponent {
  title = '{{ model.manifest.service_name }}';
  protected readonly loading = inject(LoadingService);
  private readonly notificationService = inject(NotificationService);
  protected readonly notifications = this.notificationService.notifications;
  protected readonly confirmDialog = inject(ConfirmDialogService).activeDialog;
  private readonly confirmService = inject(ConfirmDialogService);
  private readonly routeLoading = inject(RouteLoadingService);
{{ if model.angular_cognito_enabled }}
  private readonly inactivity = inject(InactivityService);
{{ end }}
{{ if model.angular_cognito_enabled }}
  protected readonly auth = inject(AuthService);
{{ end }}
  readonly sidebarCollapsed = signal(false);

  private readonly domainNavigation = inject(DomainNavigationService);
  readonly menuItems = computed(() => [
    { label: 'Dashboard', icon: 'pi pi-home', routerLink: '/dashboard' },
    ...this.domainNavigation.items(),
  ]);

  toggleSidebar(): void {
{{ if model.manifest.ui_targets | array.contains "mobile" }}
    this.sidebarCollapsed.update(value => !value);
{{ else }}
    if (this.narrowScreen()) this.mobileNavigationOpen.set(true);
    else this.sidebarCollapsed.update(value => !value);
{{ end }}
  }
{{ if model.web_admin_layout }}
  skipToContent(event: Event): void {
    event.preventDefault();
    this.document.getElementById('main-content')?.focus();
  }
{{ if model.angular_cognito_enabled }}
  readonly accountMenu = viewChild<Menu>('accountMenu');
  readonly userMenuItems: MenuItem[] = [
    { label: 'Settings', icon: 'pi pi-cog', routerLink: '/settings' },
    { separator: true },
    { label: 'Sign out', icon: 'pi pi-sign-out', command: () => this.signOut() },
  ];
{{ end }}
  private readonly document = inject(DOCUMENT);
  readonly mobileNavigationOpen = signal(false);
  readonly narrowScreen = signal(this.document.defaultView?.matchMedia('(max-width: 1023px)').matches ?? false);

  closeNavigation(restoreFocus = false): void {
    this.mobileNavigationOpen.set(false);
    if (restoreFocus && this.narrowScreen()) this.document.getElementById('navigation-toggle')?.focus();
  }

  focusNavigation(): void {
    this.document.defaultView?.requestAnimationFrame(() => {
      if (this.mobileNavigationOpen()) this.document.querySelector<HTMLElement>('.app-navigation-drawer button, .app-navigation-drawer a')?.focus();
    });
  }

  navigationVisibilityChanged(visible: boolean): void {
    if (visible) this.mobileNavigationOpen.set(true);
    else this.closeNavigation(true);
  }
{{ end }}

  constructor() {
    this.routeLoading.init();
{{ if model.web_admin_layout }}
    inject(ThemeService);
    const destroyRef = inject(DestroyRef);
    const viewport = this.document.defaultView?.matchMedia('(max-width: 1023px)');
    const resize = (): void => {
      this.narrowScreen.set(viewport?.matches ?? false);
      this.closeNavigation();
    };
    viewport?.addEventListener('change', resize);
    destroyRef.onDestroy(() => viewport?.removeEventListener('change', resize));
    const navigation = inject(Router).events.subscribe(event => {
      if (event instanceof NavigationEnd) this.closeNavigation();
    });
    destroyRef.onDestroy(() => navigation.unsubscribe());
{{ if model.angular_cognito_enabled }}
    const unregister = inject(SessionStateRegistry).register(() => { this.closeNavigation(); this.accountMenu()?.hide(); });
    destroyRef.onDestroy(unregister);
{{ end }}
{{ end }}
{{ if model.angular_cognito_enabled }}
    this.inactivity.start();
{{ end }}
  }

{{ if model.angular_cognito_enabled }}
  signOut(): void {
    void this.auth.logout();
  }
{{ end }}

  dismissNotification(id: number): void {
    this.notificationService.dismiss(id);
  }

  onConfirmOk = (): void => {
    this.confirmService.resolve(true);
  };

  onConfirmCancel = (): void => {
    this.confirmService.resolve(false);
  };
}

{{ end }}
