import { HttpInterceptorFn, HttpErrorResponse } from '@angular/common/http';
import { inject } from '@angular/core';
import { catchError, throwError } from 'rxjs';
import { LoggerService } from '../services/logger.service';

/**
 * HORIZONTAL: Logs HTTP failures. Session handling lives in authInterceptor and AuthService:
 * a 401 triggers one shared token refresh, and the session ends only when that refresh fails.
 * A 401 is not a reason to sign the user out here.
 */
export const errorInterceptor: HttpInterceptorFn = (req, next) => {
  const logger = inject(LoggerService);

  return next(req).pipe(
    catchError((error: HttpErrorResponse) => {
      switch (error.status) {
        case 401:
          logger.warn('Unauthorized request', error.url);
          break;
        case 403:
          logger.warn('Forbidden access', error.url);
          break;
        default:
          if (error.status >= 500) {
            logger.error('Server error', error.message, error.url);
          }
          break;
      }

      return throwError(() => error);
    })
  );
};
