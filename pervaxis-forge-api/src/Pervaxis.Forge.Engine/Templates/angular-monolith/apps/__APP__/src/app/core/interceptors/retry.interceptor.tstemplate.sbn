import { HttpInterceptorFn } from '@angular/common/http';
import { inject } from '@angular/core';
import { retry, timeout, timer } from 'rxjs';
import { isApiRequest } from '../auth/token-destination';
import { AppConfigService } from '../config/app-config.service';

const TIMEOUT_MS = 30_000;
const MAX_RETRIES = 2;
const RETRY_DELAY_MS = 1_000;
const RETRYABLE_METHODS = new Set(['GET', 'HEAD', 'OPTIONS']);

/**
 * HORIZONTAL: Timeout for every request, plus retries for idempotent API reads.
 * - Timeout: 30 seconds
 * - Retries: up to 2, 1 s linear backoff, only for GET/HEAD/OPTIONS to the configured API,
 *   only on 5xx or network errors. Writes are never retried: a lost response does not mean the
 *   write did not happen. Cognito sign-in calls use fetch and never pass through here.
 *
 * Vertical teams should NOT implement their own retry logic.
 */
export const retryInterceptor: HttpInterceptorFn = (req, next) => {
  const destination = inject(AppConfigService).apiDestination();
  const retryable = RETRYABLE_METHODS.has(req.method.toUpperCase())
    && destination !== null
    && isApiRequest(req.url, destination, document.baseURI);

  const request = next(req).pipe(timeout(TIMEOUT_MS));
  if (!retryable) {
    return request;
  }

  return request.pipe(
    retry({
      count: MAX_RETRIES,
      delay: (error: { status?: number }, retryCount: number) => {
        // Only retry server errors (5xx) and network failures (status 0)
        if (error.status && error.status > 0 && error.status < 500) {
          throw error;
        }
        return timer(RETRY_DELAY_MS * retryCount);
      },
    }),
  );
};
