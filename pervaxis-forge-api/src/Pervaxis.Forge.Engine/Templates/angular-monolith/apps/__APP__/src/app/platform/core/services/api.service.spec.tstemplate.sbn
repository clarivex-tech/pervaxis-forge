import { HttpHeaders, provideHttpClient } from '@angular/common/http';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { TestBed } from '@angular/core/testing';
import { firstValueFrom } from 'rxjs';
import { AppConfigService } from '../config/app-config.service';
import { ApiService } from './api.service';

describe('Platform API response contract', () => {
  let api: ApiService;
  let http: HttpTestingController;

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [
        provideHttpClient(),
        provideHttpClientTesting(),
        { provide: AppConfigService, useValue: { config: () => ({ apiUrl: 'https://api.example.test/api' }) } },
      ],
    });
    api = TestBed.inject(ApiService);
    http = TestBed.inject(HttpTestingController);
  });

  afterEach(() => http.verify());

  it('combines the configured API base with the exact server-paged Workspace endpoint', async () => {
    const response = firstValueFrom(api.getResponse<unknown>('/v1/workspace/tasks', { page: '1', pageSize: '20' }));
    const request = http.expectOne('https://api.example.test/api/v1/workspace/tasks?page=1&pageSize=20');
    expect(request.request.method).toBe('GET');
    request.flush({ items: [], page: 1, pageSize: 20, hasMore: false });
    expect((await response).status).toBe(200);
  });

  it('resolves Workspace paths for relative and absolute API bases without duplicating API segments', async () => {
    const cases = [
      { apiUrl: 'https://api.example.test', path: '/api/v1/workspace/tasks', expected: 'https://api.example.test/api/v1/workspace/tasks' },
      { apiUrl: 'https://api.example.test/api', path: '/v1/workspace/tasks', expected: 'https://api.example.test/api/v1/workspace/tasks' },
      { apiUrl: 'https://api.example.test/api/v1', path: '/api/v1/workspace/tasks', expected: 'https://api.example.test/api/v1/workspace/tasks' },
      { apiUrl: 'https://api.example.test/api/v1', path: '/v1/workspace/tasks', expected: 'https://api.example.test/api/v1/workspace/tasks' },
      { apiUrl: 'https://api.example.test/api/v1', path: '/workspace/tasks', expected: 'https://api.example.test/api/v1/workspace/tasks' },
      { apiUrl: 'https://api.example.test/api', path: '/api/v1/workspace/tasks', expected: 'https://api.example.test/api/v1/workspace/tasks' },
      { apiUrl: 'https://api.example.test', path: '/v1/workspace/tasks', expected: 'https://api.example.test/api/v1/workspace/tasks' },
      { apiUrl: '/api/v1', path: '/workspace/tasks', expected: '/api/v1/workspace/tasks' },
    ];

    for (const testCase of cases) {
      TestBed.resetTestingModule();
      TestBed.configureTestingModule({
        providers: [
          provideHttpClient(),
          provideHttpClientTesting(),
          { provide: AppConfigService, useValue: { config: () => ({ apiUrl: testCase.apiUrl }) } },
        ],
      });
      const configuredApi = TestBed.inject(ApiService);
      const configuredHttp = TestBed.inject(HttpTestingController);
      const response = firstValueFrom(configuredApi.getResponse<unknown>(testCase.path));
      const request = configuredHttp.expectOne(testCase.expected);
      expect(request.request.url).toBe(testCase.expected);
      request.flush({ items: [], page: 1, pageSize: 20, hasMore: false });
      await response;
      configuredHttp.verify();
    }
  });

  it('preserves non-Workspace endpoint paths', async () => {
    TestBed.resetTestingModule();
    TestBed.configureTestingModule({
      providers: [
        provideHttpClient(),
        provideHttpClientTesting(),
        { provide: AppConfigService, useValue: { config: () => ({ apiUrl: 'https://api.example.test/api/v1' }) } },
      ],
    });
    const configuredApi = TestBed.inject(ApiService);
    const configuredHttp = TestBed.inject(HttpTestingController);
    const response = firstValueFrom(configuredApi.getResponse<unknown>('/admin/tenants'));
    const request = configuredHttp.expectOne('https://api.example.test/api/v1/admin/tenants');
    expect(request.request.url).toBe('https://api.example.test/api/v1/admin/tenants');
    request.flush([]);
    await response;
    configuredHttp.verify();
  });

  it('preserves profile and tenant endpoints under configured API bases', async () => {
    const cases = [
      { apiUrl: 'https://api.example.test', path: '/api/v1/me', expected: 'https://api.example.test/api/v1/me' },
      { apiUrl: 'https://api.example.test/api', path: '/v1/admin/tenants', expected: 'https://api.example.test/api/v1/admin/tenants' },
      { apiUrl: 'https://api.example.test/api/v1', path: '/me', expected: 'https://api.example.test/api/v1/me' },
      { apiUrl: '/api/v1', path: '/admin/tenants', expected: '/api/v1/admin/tenants' },
    ];

    for (const testCase of cases) {
      TestBed.resetTestingModule();
      TestBed.configureTestingModule({
        providers: [
          provideHttpClient(),
          provideHttpClientTesting(),
          { provide: AppConfigService, useValue: { config: () => ({ apiUrl: testCase.apiUrl }) } },
        ],
      });
      const configuredApi = TestBed.inject(ApiService);
      const configuredHttp = TestBed.inject(HttpTestingController);
      const response = firstValueFrom(configuredApi.getResponse<unknown>(testCase.path));
      const request = configuredHttp.expectOne(testCase.expected);
      expect(request.request.url).toBe(testCase.expected);
      request.flush({});
      await response;
      configuredHttp.verify();
    }
  });

  it('preserves strong If-Match headers and response ETags on conditional writes', async () => {
    const version = '123e4567-e89b-12d3-a456-426614174000';
    const etag = '"' + version + '"';
    const response = firstValueFrom(api.putResponse<unknown>('/v1/workspace/tasks/' + version,
      { title: 'Review', description: null, isCompleted: true }, { 'If-Match': etag }));
    const request = http.expectOne('https://api.example.test/api/v1/workspace/tasks/' + version);
    expect(request.request.method).toBe('PUT');
    expect(request.request.headers.get('If-Match')).toBe(etag);
    request.flush({ version }, { headers: new HttpHeaders({ ETag: etag }) });
    const result = await response;
    expect(result.headers.get('ETag')).toBe(etag);
  });

  it('supports the required no-content conditional delete response', async () => {
    const version = '123e4567-e89b-12d3-a456-426614174000';
    const response = firstValueFrom(api.deleteResponse<void>('/v1/workspace/tasks/' + version, {
      'If-Match': '"' + version + '"',
    }));
    const request = http.expectOne('https://api.example.test/api/v1/workspace/tasks/' + version);
    expect(request.request.method).toBe('DELETE');
    expect(request.request.headers.get('If-Match')).toBe('"' + version + '"');
    request.flush(null, { status: 204, statusText: 'No Content' });
    expect((await response).status).toBe(204);
  });
});
{{ end }}
