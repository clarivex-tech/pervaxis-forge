/* App Shell Layout */
.app-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-surface, #fff);
  border-bottom: 1px solid var(--color-border, #e5e7eb);
  padding: var(--spacing-sm) var(--spacing-lg);
}

.app-header__nav {
  display: flex;
  align-items: center;
  gap: var(--spacing-lg);
  max-width: 1280px;
  margin: 0 auto;
}

.app-header__brand {
  font-weight: 700;
  font-size: 1.125rem;
  color: var(--color-primary);
}

.app-layout {
  display: flex;
  min-height: calc(100vh - 49px);
}

.app-sidebar {
  width: 240px;
  background: var(--color-surface, #f9fafb);
  border-right: 1px solid var(--color-border, #e5e7eb);
  padding: var(--spacing-lg) 0;
  flex-shrink: 0;
}

.app-sidebar__nav {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  padding: 0 var(--spacing-sm);
}

.app-sidebar__nav a {
  display: block;
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  color: var(--color-text, #1f2937);
  text-decoration: none;
  font-size: 0.875rem;
  transition: background 0.15s;
}

.app-sidebar__nav a:hover {
  background: var(--color-border, #e5e7eb);
}

.app-sidebar__nav a.active {
  background: var(--color-primary);
  color: white;
}

.app-content {
  flex: 1;
  padding: var(--spacing-lg);
  overflow-y: auto;
}

/* Notification Toasts */
.notification-container {
  position: fixed;
  top: var(--spacing-lg);
  right: var(--spacing-lg);
  z-index: 9998;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  max-width: 360px;
}

.notification-toast {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) var(--spacing-md);
  border-radius: var(--radius-md);
  font-size: 0.875rem;
  box-shadow: var(--shadow-md);
  animation: slideIn 0.2s ease-out;
}

.notification-toast--success { background: #d1fae5; color: #065f46; }
.notification-toast--error { background: #fee2e2; color: #991b1b; }
.notification-toast--warning { background: #fef3c7; color: #92400e; }
.notification-toast--info { background: #dbeafe; color: #1e40af; }

.notification-toast button {
  background: none;
  border: none;
  font-size: 1.25rem;
  cursor: pointer;
  opacity: 0.6;
  line-height: 1;
}

/* Confirmation Dialog */
.confirm-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
}

.confirm-dialog {
  background: white;
  border-radius: var(--radius-lg);
  padding: var(--spacing-xl);
  max-width: 400px;
  width: 90%;
  box-shadow: var(--shadow-lg);
}

.confirm-dialog h3 {
  margin: 0 0 var(--spacing-sm);
  font-size: 1.125rem;
}

.confirm-dialog p {
  margin: 0 0 var(--spacing-lg);
  color: var(--color-text-muted);
  font-size: 0.875rem;
}

.confirm-actions {
  display: flex;
  justify-content: flex-end;
  gap: var(--spacing-sm);
}

.btn {
  padding: var(--spacing-sm) var(--spacing-md);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: white;
  cursor: pointer;
  font-size: 0.875rem;
}

.btn--danger {
  background: var(--color-danger);
  color: white;
  border-color: var(--color-danger);
}

@keyframes slideIn {
  from { transform: translateX(100%); opacity: 0; }
  to { transform: translateX(0); opacity: 1; }
}

/* Responsive */
@media (max-width: 768px) {
  .app-sidebar {
    display: none;
  }

  .app-layout {
    flex-direction: column;
  }
}
