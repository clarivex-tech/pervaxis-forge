import { Component, inject } from '@angular/core';
import { RouterOutlet, RouterLink, RouterLinkActive } from '@angular/router';
{{ if model.manifest.ui_targets | array.contains "mobile" }}
import { IonApp, IonRouterOutlet, IonProgressBar, IonToast, IonAlert } from '@ionic/angular/standalone';
{{ end }}
import { ToolbarModule } from 'primeng/toolbar';
import { ButtonModule } from 'primeng/button';
import { AvatarModule } from 'primeng/avatar';
import { MenuModule } from 'primeng/menu';
import { RippleModule } from 'primeng/ripple';
import { LoadingService } from './core/services/loading.service';
import { NotificationService } from './core/services/notification.service';
import { ConfirmDialogService } from '@shared/services/confirm-dialog.service';
import { RouteLoadingService } from './core/services/route-loading.service';
import { InactivityService } from './core/services/inactivity.service';
import { AuthService } from './core/auth/auth.service';
import { TenantContextService } from './core/auth/tenant-context.service';

/**
 * Root application component.
 *
 * HORIZONTAL (do not modify):
 *   - Loading indicator
 *   - Notification toasts
 *   - Confirmation dialog
 *   - App shell layout (header, sidebar)
 *   - Route loading, inactivity detection
 *   - Signed-in user, tenant and sign-out in the header (cross-tab sign-out runs in AuthService)
 *
 * VERTICAL (extend as needed):
 *   - Add navigation links in the header/sidebar
 *   - Add shared UI imports to the imports array
 */
@Component({
  selector: '{{ model.manifest.component_prefix }}-root',
  standalone: true,
{{ if model.manifest.ui_targets | array.contains "mobile" }}
  imports: [IonApp, IonRouterOutlet, IonProgressBar, IonToast, IonAlert],
{{ else }}
  imports: [RouterOutlet, RouterLink, RouterLinkActive, ToolbarModule, ButtonModule, AvatarModule, MenuModule, RippleModule],
{{ end }}
  templateUrl: './app.component.html',
  styleUrls: ['./app.component.scss'],
})
export class AppComponent {
  title = '{{ model.manifest.service_name }}';
  protected readonly loading = inject(LoadingService);
  protected readonly notifications = inject(NotificationService).notifications;
  protected readonly confirmDialog = inject(ConfirmDialogService).activeDialog;
  private readonly confirmService = inject(ConfirmDialogService);
  private readonly routeLoading = inject(RouteLoadingService);
  private readonly inactivity = inject(InactivityService);
  protected readonly auth = inject(AuthService);
  protected readonly tenant = inject(TenantContextService);

  sidebarCollapsed = false;

  menuItems = [
    { label: 'Dashboard', icon: 'pi pi-home', routerLink: '/dashboard' },
  ];

  toggleSidebar(): void {
    this.sidebarCollapsed = !this.sidebarCollapsed;
  }

  constructor() {
    this.routeLoading.init();
    this.inactivity.start();
  }

  signOut(): void {
    void this.auth.logout();
  }

  dismissNotification(id: number): void {
    inject(NotificationService).dismiss(id);
  }

  onConfirmOk = (): void => {
    this.confirmService.resolve(true);
  };

  onConfirmCancel = (): void => {
    this.confirmService.resolve(false);
  };
}
