export const WORKSPACE_STATUSES: readonly WorkspaceStatus[] = ['Active', 'Suspended', 'Archived'];
export const WORKSPACE_PLANS: readonly WorkspacePlan[] = ['Standard', 'Professional', 'Enterprise'];

/** Configuration value that explicitly selects the in-browser mock data source. */
export const WORKSPACE_RECORDS_MODE_OPTION = 'workspaceRecordsMode';
export const WORKSPACE_RECORDS_MOCK_MODE = 'mock';

/** Button labels and toast copy share one verb per action. */
export const WORKSPACE_COPY = {
  mockBanner: 'Workspaces, members, audit history, export and restore are simulated in this browser session. No API, database or AWS service is called.',
  toast: {
    created: 'Workspace created',
    updated: 'Changes saved',
    suspended: 'Workspaces suspended',
    deleted: 'Workspace deleted',
    deletedMany: 'Workspaces deleted',
    restored: 'Workspaces restored (mock)',
    exported: 'Export prepared (mock). No file was generated.',
