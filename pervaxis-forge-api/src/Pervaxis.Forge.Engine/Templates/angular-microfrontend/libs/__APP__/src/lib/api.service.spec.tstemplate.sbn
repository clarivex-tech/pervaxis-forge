import { TestBed } from '@angular/core/testing';
import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
import { provideHttpClient } from '@angular/common/http';
import { {{ model.names.angular_mfe_component_name }}ApiService } from './api.service';

describe('{{ model.names.angular_mfe_component_name }}ApiService', () => {
  let service: {{ model.names.angular_mfe_component_name }}ApiService;
  let httpMock: HttpTestingController;

  beforeEach(() => {
    TestBed.configureTestingModule({
      providers: [provideHttpClient(), provideHttpClientTesting()],
    });
    service = TestBed.inject({{ model.names.angular_mfe_component_name }}ApiService);
    httpMock = TestBed.inject(HttpTestingController);
  });

  afterEach(() => {
    httpMock.verify();
  });

  it('should be created', () => {
    expect(service).toBeTruthy();
  });

  it('should call GET on getAll()', () => {
    service.getAll().subscribe();
    const req = httpMock.expectOne('{{ model.names.api_base_route }}');
    expect(req.request.method).toBe('GET');
    req.flush([]);
  });

  it('should call GET with id on getById()', () => {
    service.getById('123').subscribe();
    const req = httpMock.expectOne('{{ model.names.api_base_route }}/123');
    expect(req.request.method).toBe('GET');
    req.flush({ id: '123' });
  });
});
