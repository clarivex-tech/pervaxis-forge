import { ChangeDetectionStrategy, Component, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
{{- for m in model.selected_canvas_modules }}
import { {{ m.import_name }} } from '{{ m.package_name }}';
{{- end }}
import { {{ model.names.angular_mfe_component_name }}ApiService } from './api.service';

@Component({
  selector: '{{ model.manifest.component_prefix }}-{{ model.names.angular_mfe_route_path }}',
  standalone: true,
  imports: [
    CommonModule,
{{- for m in model.selected_canvas_modules }}
    {{ m.import_name }},
{{- end }}
  ],
  templateUrl: './component.html',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class {{ model.names.angular_mfe_component_name }} {
  private readonly apiService = inject({{ model.names.angular_mfe_component_name }}ApiService);
}
