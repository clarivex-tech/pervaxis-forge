import { inject, Injectable } from '@angular/core';
import { HttpClient } from '@angular/common/http';
import { Observable } from 'rxjs';

/** Domain model — replace with your actual DTO interface */
export interface DomainItem {
  id: string;
  [key: string]: unknown;
}

@Injectable({ providedIn: 'root' })
export class {{ model.names.angular_mfe_component_name }}ApiService {
  private readonly baseUrl = '{{ model.names.api_base_route }}';
  private readonly http = inject(HttpClient);

  getAll(): Observable<DomainItem[]> {
    return this.http.get<DomainItem[]>(this.baseUrl);
  }

  getById(id: string): Observable<DomainItem> {
    return this.http.get<DomainItem>(`${this.baseUrl}/${id}`);
  }
}
