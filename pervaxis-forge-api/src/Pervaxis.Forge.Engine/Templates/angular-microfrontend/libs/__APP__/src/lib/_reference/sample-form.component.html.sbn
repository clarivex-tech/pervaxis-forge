<div class="sample-form">
  @if (isEditMode()) {
    <h1>Edit Sample</h1>
  } @else {
    <h1>Create Sample</h1>
  }

  @if (loading()) {
    <p class="sample-form__loading">Loading...</p>
  } @else {
    <form [formGroup]="form" (ngSubmit)="onSubmit()" class="sample-form__body">
      <div class="form-field">
        <label for="name" class="form-field__label">Name *</label>
        <input
          id="name"
          type="text"
          formControlName="name"
          class="form-field__input"
          [class.form-field__input--error]="form.get('name')?.invalid && form.get('name')?.touched"
        />
        @if (form.get('name')?.hasError('required') && form.get('name')?.touched) {
          <span class="form-field__error">Name is required</span>
        }
        @if (form.get('name')?.hasError('minlength') && form.get('name')?.touched) {
          <span class="form-field__error">Name must be at least 3 characters</span>
        }
      </div>

      <div class="form-field">
        <label for="description" class="form-field__label">Description</label>
        <textarea
          id="description"
          formControlName="description"
          class="form-field__input form-field__textarea"
          rows="4"
        ></textarea>
      </div>

      <div class="form-field">
        <label for="status" class="form-field__label">Status *</label>
        <select
          id="status"
          formControlName="status"
          class="form-field__input"
          [class.form-field__input--error]="form.get('status')?.invalid && form.get('status')?.touched"
        >
          <option value="active">Active</option>
          <option value="inactive">Inactive</option>
        </select>
        @if (form.get('status')?.hasError('required') && form.get('status')?.touched) {
          <span class="form-field__error">Status is required</span>
        }
      </div>

      <div class="sample-form__actions">
        @if (isEditMode()) {
          <button type="submit" class="btn btn--primary" [disabled]="form.invalid">Update</button>
        } @else {
          <button type="submit" class="btn btn--primary" [disabled]="form.invalid">Create</button>
        }
        <button type="button" class="btn" (click)="onCancel()">Cancel</button>
      </div>
    </form>
  }
</div>

<style>
  .sample-form {
    padding: var(--spacing-lg, 1.5rem);
    max-width: 600px;
  }

  .sample-form__body {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md, 1rem);
  }

  .sample-form__actions {
    display: flex;
    gap: var(--spacing-sm, 0.5rem);
    margin-top: var(--spacing-md, 1rem);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs, 0.25rem);
  }

  .form-field__label {
    font-weight: 500;
    font-size: 0.875rem;
    color: var(--color-text, #333);
  }

  .form-field__input {
    padding: var(--spacing-sm, 0.5rem);
    border: 1px solid var(--color-border, #e0e0e0);
    border-radius: var(--radius-sm, 4px);
    font-size: 1rem;
    background: var(--color-surface, #fff);
    color: var(--color-text, #333);
  }

  .form-field__input:focus {
    outline: 2px solid var(--color-primary, #1976d2);
    outline-offset: 1px;
  }

  .form-field__input--error {
    border-color: var(--color-error, #d32f2f);
  }

  .form-field__textarea {
    resize: vertical;
  }

  .form-field__error {
    font-size: 0.75rem;
    color: var(--color-error, #d32f2f);
  }

  .btn {
    padding: var(--spacing-sm, 0.5rem) var(--spacing-md, 1rem);
    border: 1px solid var(--color-border, #e0e0e0);
    border-radius: var(--radius-sm, 4px);
    background: var(--color-surface, #fff);
    color: var(--color-text, #333);
    cursor: pointer;
    font-size: 0.875rem;
  }

  .btn--primary {
    background: var(--color-primary, #1976d2);
    color: var(--color-on-primary, #fff);
    border-color: var(--color-primary, #1976d2);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
