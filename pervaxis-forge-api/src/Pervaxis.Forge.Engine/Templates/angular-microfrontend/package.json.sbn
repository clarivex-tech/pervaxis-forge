{
  "name": "@{{ model.manifest.product }}/{{ model.manifest.service_name }}",
  "version": "{{ if model.manifest.metadata && model.manifest.metadata.version; model.manifest.metadata.version; else; '0.1.0'; end }}",
  "scripts": {
    "build": "nx build {{ model.manifest.service_name }}",
    "test": "nx test {{ model.manifest.service_name }}",
    "lint": "nx lint {{ model.manifest.service_name }}"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@nx/angular": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"{{- if model.selected_canvas_modules | array.size > 0 }},
{{- for m in model.selected_canvas_modules }}
    "{{ m.package_name }}": "{{ m.version }}"{{ if !for.last }},{{ end }}
{{- end }}
{{- end }}
  },
  "devDependencies": {
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-eslint/eslint-plugin": "^21.0.0",
    "@angular-eslint/eslint-plugin-template": "^21.0.0",
    "@angular-eslint/template-parser": "^21.0.0",
    "@nx/eslint": "^21.0.0",
    "@nx/jest": "^21.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.9.0"
  }
}
