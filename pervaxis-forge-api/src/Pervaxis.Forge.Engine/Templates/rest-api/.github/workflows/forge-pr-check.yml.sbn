name: PR Check

on:
  pull_request:
    branches: [main, develop]
    paths:
      - 'pervaxis-forge-api/**'
      - '.github/workflows/forge-*.yml'

defaults:
  run:
    working-directory: pervaxis-forge-api

env:
  DOTNET_NOLOGO: true
  DOTNET_SKIP_FIRST_TIME_EXPERIENCE: true
  DOTNET_CLI_TELEMETRY_OPTOUT: true

jobs:
  build-test-scan:
    name: Build · Test · SonarQube
    runs-on: ubuntu-latest
    env:
      SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
    steps:
      - uses: actions/checkout@v5
        with:
          fetch-depth: 0

      - uses: actions/setup-dotnet@v5
        with:
          dotnet-version: "10.x"

      - uses: actions/cache@v5
        with:
          path: ~/.nuget/packages
          key: ${{ runner.os }}-nuget-${{ hashFiles('**/*.csproj') }}
          restore-keys: ${{ runner.os }}-nuget-

      - run: dotnet restore Pervaxis.Forge.slnx
      - run: dotnet build Pervaxis.Forge.slnx --no-restore --configuration Release

      - name: Test with coverage
        run: |
          dotnet test Pervaxis.Forge.slnx --no-build --configuration Release \
            --filter "Category!=Integration" \
            --collect:"XPlat Code Coverage" --results-directory TestResults \
            -- DataCollectionRunSettings.DataCollectors.DataCollector.Configuration.Format=opencover

      - uses: actions/upload-artifact@v5
        if: always()
        with:
          name: pr-test-results-${{ github.run_id }}
          path: pervaxis-forge-api/TestResults/
          retention-days: 7
