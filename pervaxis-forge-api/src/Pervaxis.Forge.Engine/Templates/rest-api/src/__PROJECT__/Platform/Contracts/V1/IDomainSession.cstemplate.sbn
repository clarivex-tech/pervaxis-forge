namespace Pervaxis.Forge.Contracts.V1;

/// <summary>Tracked EF operations through the host's one tenant-aware context. Never disable tenant filters.</summary>
public interface IDomainSession
{
    /// <summary>Returns a tracked query; scope every user-owned operation by the validated owner as well.</summary>
    IQueryable<TEntity> Query<TEntity>() where TEntity : class;
    /// <summary>Tracks an insertion. The host stamps the tenant on save.</summary>
    void Add<TEntity>(TEntity entity) where TEntity : class;
    /// <summary>Tracks deletion of an entity selected with the required tenant and owner predicates.</summary>
    void Remove<TEntity>(TEntity entity) where TEntity : class;
    /// <summary>Saves through the shared context and its tenant-write protections.</summary>
    Task<int> SaveChangesAsync(CancellationToken cancellationToken = default);
}
