namespace Pervaxis.Forge.Contracts.V1;

/// <summary>The validated human bearer subject for the current request; never an API-key or machine identity.</summary>
/// <remarks>Subjects are scoped to the host's configured issuer. Changing issuer requires an explicit identity/data migration.</remarks>
public interface IUserContext
{
    /// <summary>Returns the subject or null when no supported, validated human bearer identity is available.</summary>
    Task<string?> GetSubjectAsync(CancellationToken cancellationToken = default);
}
