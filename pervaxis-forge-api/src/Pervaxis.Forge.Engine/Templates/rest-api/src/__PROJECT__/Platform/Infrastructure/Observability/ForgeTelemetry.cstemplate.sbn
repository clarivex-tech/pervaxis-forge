using System.Diagnostics;
using System.Diagnostics.Metrics;
using System.Reflection;

namespace {{ model.names.namespace }}.Platform.Infrastructure.Observability;

/// <summary>
/// Telemetry this service emits itself. Create custom spans with <see cref="ActivitySource"/> and custom
/// metrics with <see cref="Meter"/> from here. TracingExtensions registers both, so they are exported.
/// </summary>
public static class ForgeTelemetry
{
    public const string ActivitySourceName = "{{ model.names.namespace }}";
    public const string MeterName = "{{ model.names.namespace }}";

    /// <summary>The informational version of the running build. Stamped on every span, metric and log line.</summary>
    public static readonly string ServiceVersion =
        Assembly.GetEntryAssembly()?.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
        ?? "unknown";

    public static readonly ActivitySource ActivitySource = new(ActivitySourceName, ServiceVersion);

    public static readonly Meter Meter = new(MeterName, ServiceVersion);

    /// <summary>Requests at or above Forge:Observability:SlowRequestThresholdMilliseconds, by route.</summary>
    public static readonly Counter<long> SlowRequests = Meter.CreateCounter<long>(
        "forge.slow_requests", "{request}", "Requests slower than the configured threshold.");

    /// <summary>Requests that ended in a 5xx response, by exception type.</summary>
    public static readonly Counter<long> ServerErrors = Meter.CreateCounter<long>(
        "forge.server_errors", "{request}", "Requests that ended in a 5xx response.");
}
