namespace {{ model.names.namespace }}.Platform.Profile;

/// <summary>The caller context admitted by this API; identity-provider profile attributes are separate.</summary>
public sealed record MeResponse
{
    public required string Subject { get; init; }
    public required MeTenantResponse Tenant { get; init; }
    /// <summary>Values of the configured group claim used by API policies, not a complete permission list.</summary>
    public required IReadOnlyList<string> Roles { get; init; }
}
