using Pervaxis.Forge.Contracts.V1;
using {{ model.names.namespace }}.Platform.Infrastructure.Extensions;
using {{ model.names.namespace }}.Platform.Infrastructure.Http;
using {{ model.names.namespace }}.Platform.Infrastructure.Domains;

namespace {{ model.names.namespace }}.Platform.Extensions;

public static class ServiceCollectionExtensions
{
    public static IServiceCollection Add{{ model.names.dot_net_class_name }}Services(
        this IServiceCollection services,
        IConfiguration configuration)
    {
        services.AddScoped<IDomainQueries, DomainQueries>();
        services.AddForgeDomains(configuration);

        // HTTP client with full DelegatingHandler chain:
        // CorrelationId -> JwtPropagation -> HttpLogging -> Resilience (retry + circuit breaker + timeout)
        // Handlers whose feature is switched off for this service are left out of the chain.
        services.AddHttpClient<IForgeInternalHttpClient, ForgeInternalHttpClient>()
{{- if model.manifest.observability == null || model.manifest.observability.correlation_id_enabled }}
            .AddHttpMessageHandler<CorrelationIdHandler>()
{{- end }}
            .AddHttpMessageHandler<JwtPropagationHandler>()
{{- if model.manifest.observability == null || model.manifest.observability.serilog_enabled }}
            .AddHttpMessageHandler<HttpLoggingHandler>()
{{- end }}
{{- if model.manifest.resilience == null || model.manifest.resilience.retry_enabled || model.manifest.resilience.circuit_breaker_enabled || model.manifest.resilience.timeout_enabled }}
            .AddForgeResilience(configuration.GetSection("Resilience:Default"))
{{- end }};

        return services;
    }
}
