using System.Security.Claims;
using System.Text.Json;
using Microsoft.AspNetCore.Authentication;
using Microsoft.AspNetCore.Authentication.JwtBearer;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Options;
using Microsoft.IdentityModel.JsonWebTokens;
using Microsoft.IdentityModel.Tokens;
using Pervaxis.Core.Abstractions.MultiTenancy;
using {{ model.names.namespace }}.Platform.Infrastructure.Extensions;
using {{ model.names.namespace }}.Platform.Models.Configuration;

namespace {{ model.names.namespace }}.Platform.Profile;

/// <summary>Read-only application context for the signed-in Cognito user. Ordinary tenant admission applies.</summary>
[ApiController]
[Route("api/v1/me")]
[Authorize(Policy = AuthorizationPolicyExtensions.SelfProfilePolicy)]
[ResponseCache(NoStore = true, Location = ResponseCacheLocation.None)]
public sealed class MeController(
    ITenantContext tenant,
    IOptions<ForgeAuthorizationOptions> authorization,
    IOptions<ForgeOidcOptions> oidc) : ControllerBase
{
    [HttpGet]
    [ProducesResponseType(typeof(MeResponse), StatusCodes.Status200OK)]
    [ProducesResponseType(StatusCodes.Status401Unauthorized)]
    [ProducesResponseType(StatusCodes.Status403Forbidden)]
    [ProducesResponseType(StatusCodes.Status503ServiceUnavailable)]
    public async Task<ActionResult<MeResponse>> GetAsync()
    {
        // This is the bearer token accepted by JwtBearer, never a body/query token or an ID token.
        var token = await HttpContext.GetTokenAsync(JwtBearerDefaults.AuthenticationScheme, "access_token");
        var subject = ReadUserSubject(User, token);
        if (subject is null)
            return Problem(statusCode: StatusCodes.Status401Unauthorized, title: "A user access token is required.",
                type: "urn:pervaxis:profile:user_identity_required");

        // Defense in depth: do not expose a fallback tenant if the admission pipeline was omitted.
        if (!tenant.IsResolved || tenant.Status != TenantStatus.Active)
            return Problem(statusCode: StatusCodes.Status403Forbidden, title: "An active tenant is required.",
                type: "urn:pervaxis:profile:tenant_required");

        var groupClaim = AuthorizationPolicyExtensions.ResolveGroupClaimType(oidc.Value.Provider, authorization.Value.GroupClaimType);
        var roles = User.FindAll(groupClaim).Select(claim => claim.Value)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.Ordinal).Order(StringComparer.Ordinal).ToArray();

        return Ok(new MeResponse
        {
            Subject = subject,
            Tenant = new MeTenantResponse { Id = tenant.TenantId.Value, Name = tenant.TenantName },
            Roles = roles,
        });
    }

    private static string? ReadUserSubject(ClaimsPrincipal principal, string? token)
    {
        if (principal.Identity?.IsAuthenticated != true || string.IsNullOrWhiteSpace(token))
            return null;

        // Inspect only the payload of the token ALREADY accepted by JwtBearer. Principal claims flatten
        // JSON arrays and can hide duplicate JSON properties; user identity must be scalar and unambiguous.
        using var payload = JsonDocument.Parse(Base64UrlEncoder.Decode(new JsonWebToken(token).EncodedPayload));
        var subject = ReadScalar(payload.RootElement, "sub");
        var username = ReadScalar(payload.RootElement, "username");
        var clientId = ReadScalar(payload.RootElement, "client_id");
        if (subject is null || username is null || clientId is null
            || string.Equals(subject, clientId, StringComparison.Ordinal))
            return null; // Client-credentials tokens identify the client in sub and do not identify a user.

        var subjects = principal.FindAll("sub").ToArray();
        return subjects.Length == 1 && string.Equals(subjects[0].Value, subject, StringComparison.Ordinal)
            ? subject : null;
    }

    private static string? ReadScalar(JsonElement payload, string name)
    {
        var values = payload.EnumerateObject().Where(property => property.NameEquals(name)).ToArray();
        if (values.Length != 1 || values[0].Value.ValueKind != JsonValueKind.String)
            return null;
        var value = values[0].Value.GetString();
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }
}
{{ end }}
