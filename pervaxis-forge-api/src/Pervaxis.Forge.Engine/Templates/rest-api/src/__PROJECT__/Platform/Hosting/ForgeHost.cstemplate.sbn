using {{ model.names.namespace }}.Platform.Extensions;
using {{ model.names.namespace }}.Platform.Infrastructure.Extensions;
using {{ model.names.namespace }}.Platform.Infrastructure.Http;
using {{ model.names.namespace }}.Platform.Infrastructure.Middleware;
using {{ model.names.namespace }}.Platform.Infrastructure.Security;
{{- for module in model.selected_modules }}{{ if module.display_name == "OData" }}
using {{ model.names.namespace }}.Platform.Infrastructure.Validation;
{{- end }}{{ end }}
{{- if !model.manifest.tenant_ready }}
using {{ model.names.namespace }}.Platform.Infrastructure.Tenancy;
{{- else }}
using Pervaxis.Core.Abstractions.MultiTenancy;
using Pervaxis.Core.Data.EntityFrameworkCore;
using Pervaxis.Core.MultiTenancy;
using {{ model.names.namespace }}.Data.Tenancy;
using {{ model.names.namespace }}.Platform.Tenancy.Services;
using {{ model.names.namespace }}.Platform.Tenancy;
{{- end }}
{{- if model.manifest.has_messaging }}
using {{ model.names.namespace }}.Platform.Infrastructure.Outbox;
{{- end }}
using {{ model.names.namespace }}.Platform.Models.Configuration;
{{- for module in model.selected_modules }}
using {{ module.package_name }}.Extensions;
{{- end }}
using Amazon.Extensions.NETCore.Setup;
using Amazon.SecretsManager;
using Microsoft.AspNetCore.Authentication;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.ResponseCompression;
using Microsoft.AspNetCore.OutputCaching;
using Microsoft.AspNetCore.RateLimiting;
using Microsoft.EntityFrameworkCore;
using Microsoft.OpenApi.Models;
using System.Diagnostics;
using System.Threading.RateLimiting;
{{- if model.manifest.database != null }}
using {{ model.names.namespace }}.Platform.Data;
using {{ model.names.namespace }}.Platform.Infrastructure.Database;
{{- end }}
using Microsoft.AspNetCore.Diagnostics.HealthChecks;
using {{ model.names.namespace }}.Platform.Auth;
using {{ model.names.namespace }}.Platform.Services;

namespace {{ model.names.namespace }}.Platform.Hosting;

/// <summary>Print-owned host composition and HTTP pipeline.</summary>
public static class ForgeHost
{
    public static async Task RunAsync(string[] args)
    {
        var builder = WebApplication.CreateBuilder(args);

        // -- Structured Logging (Serilog + CloudWatch) ------------------------------------------
{{ if model.manifest.observability == null || model.manifest.observability.serilog_enabled }}
        builder.AddForgeSerilog();
{{ end }}

        builder.Services.Add{{ model.names.dot_net_class_name }}Services(builder.Configuration);
        builder.Services.AddDefaultAWSOptions(builder.Configuration.GetAWSOptions());
        builder.Services.AddAWSService<IAmazonSecretsManager>();
{{- has_sanitization = false }}
{{- has_odata = false }}
{{- for module in model.selected_modules }}
{{- if module.display_name == "Sanitization" }}{{ has_sanitization = true }}{{ end }}
{{- if module.display_name == "OData" }}{{ has_odata = true }}{{ end }}
{{- if module.uses_genesis_section }}
        // {{ module.display_name }} reads its settings from "Genesis:{{ module.display_name }}".
        builder.Services.{{ module.di_extension_name }}(builder.Configuration);
{{- else }}
        builder.Services.{{ module.di_extension_name }}(
            builder.Configuration.GetSection("{{ module.display_name }}"));
{{- end }}
{{- end }}
{{- if has_odata }}
        // Rejects negative $top/$skip on [ODataQueryable] endpoints (Genesis OData 3.4 passes them through).
        builder.Services.AddODataPagingGuard();
{{- end }}

        builder.Services.AddControllers().AddApplicationPart(typeof(ForgeHost).Assembly);
        builder.Services.AddEndpointsApiExplorer();
        builder.Services.AddResponseCompression(options =>
        {
            options.EnableForHttps = true;
        });

        // -- Configuration options --------------------------------------------------------
        builder.Services.Configure<ForgeResilienceOptions>(
            builder.Configuration.GetSection(ForgeResilienceOptions.SectionName));
        builder.Services.AddOptions<ForgeDataClassificationOptions>()
            .BindConfiguration(ForgeDataClassificationOptions.SectionName);
        builder.Services.AddOptions<ForgeAuthenticationOptions>()
            .BindConfiguration(ForgeAuthenticationOptions.SectionName);
        builder.Services.AddOptions<ForgeSecretsOptions>()
            .BindConfiguration(ForgeSecretsOptions.SectionName);
        builder.Services.AddOptions<ForgeObservabilityOptions>()
            .BindConfiguration(ForgeObservabilityOptions.SectionName);
        builder.Services.AddSingleton<ForgeDataRedaction>();
        builder.Services.AddOptions<ForgeOutputCachingOptions>()
            .BindConfiguration(ForgeOutputCachingOptions.SectionName);
        var outputCaching = builder.Configuration.GetSection(ForgeOutputCachingOptions.SectionName)
            .Get<ForgeOutputCachingOptions>() ?? new ForgeOutputCachingOptions();
        builder.Services.AddOutputCache(options =>
        {
            // Nothing is cached unless an endpoint opts in with [OutputCache(PolicyName = ForgeOutputCachingOptions.PublicPolicy)].
            // That policy caches anonymous responses only. Do not add a policy for authenticated callers
            // without varying the cache key by user and tenant.
            options.AddPolicy(ForgeOutputCachingOptions.PublicPolicy,
                policy => policy.AddForgeDefaultOutputCache(outputCaching.DefaultExpirationSeconds));
        });
        builder.Services.AddOptions<ForgeRateLimitingOptions>()
            .BindConfiguration(ForgeRateLimitingOptions.SectionName);
        builder.Services.AddRateLimiter(limiterOptions =>
        {
            var rateLimiting = builder.Configuration.GetSection(ForgeRateLimitingOptions.SectionName)
                .Get<ForgeRateLimitingOptions>() ?? new ForgeRateLimitingOptions();

            if (rateLimiting.Enabled)
            {
                limiterOptions.RejectionStatusCode = StatusCodes.Status429TooManyRequests;
                limiterOptions.GlobalLimiter = PartitionedRateLimiter.Create<HttpContext, string>(context =>
                    RateLimitPartition.GetFixedWindowLimiter(
                        partitionKey: context.User.Identity?.Name ?? context.Connection.RemoteIpAddress?.ToString() ?? "anonymous",
                        factory: _ => new FixedWindowRateLimiterOptions
                        {
                            PermitLimit = Math.Max(1, rateLimiting.PermitLimit),
                            Window = TimeSpan.FromMinutes(Math.Max(1, rateLimiting.WindowMinutes)),
                            QueueLimit = 0,
                            AutoReplenishment = true,
                        }));
            }
        });

        const string ForgeUiCorsPolicy = "ForgeUi";
        builder.Services.AddCors(options =>
        {
            // No built-in fallback: an environment without Forge:Cors:AllowedOrigins allows no browser origins.
            // localhost is listed only in appsettings.Development.json; set real UI origins per environment.
            var allowedOrigins = builder.Configuration
                .GetSection("Forge:Cors:AllowedOrigins")
                .Get<string[]>() ?? [];

            options.AddPolicy(ForgeUiCorsPolicy, policy => policy
                .WithOrigins(allowedOrigins)
                .AllowAnyHeader()
                .WithExposedHeaders("ETag")
                .AllowAnyMethod());
        });
        // -- Authentication (API Key + optional JWT/OIDC) ------------------------------------
        builder.Services.AddForgeAuthentication(builder.Configuration);
        builder.Services.Configure<ForgeOidcOptions>(builder.Configuration.GetSection(ForgeOidcOptions.SectionName));
{{- if !model.manifest.tenant_ready }}
        builder.Services.Configure<ForgeTenantOptions>(builder.Configuration.GetSection(ForgeTenantOptions.SectionName));
{{- else }}
        // -- Tenancy (see DeveloperReference/Tenancy.md) ------------------------------------------
        // Multi-tenant only. The initial tenant seed is never used as a request fallback.
        // Forge:Tenant:Mode = MultiTenant: the tenant comes only from the validated access-token claim, never from a header.
        builder.Services.AddPervaxisClaimsMultiTenancy(options =>
        {
            builder.Configuration.GetSection("Forge:Tenant").Bind(options);
            if (options.Mode != TenancyMode.MultiTenant || options.ClaimType != "tenant_id" || !options.EnableDirectoryChecks)
                throw new InvalidOperationException("This print requires MultiTenant mode, tenant_id claims, and tenant directory checks.");
            if (string.IsNullOrWhiteSpace(options.DefaultTenantId))
                options.DefaultTenantId = TenantDefaults.DefaultTenantId;
        });
        builder.Services.AddOptions<ClaimsTenantOptions>()
            .Validate(options => options.Mode == TenancyMode.MultiTenant && options.ClaimType == "tenant_id" && options.EnableDirectoryChecks,
                "This print requires MultiTenant mode, tenant_id claims, and tenant directory checks.")
            .ValidateOnStart();
        // Tenant status checks read the tenants table (Data/Tenancy). Suspended or unknown tenants get 403.
        builder.Services.AddScoped<ITenantDirectory, EfTenantDirectory>();
        builder.Services.AddScoped<ITenantManagementService, TenantManagementService>();
        builder.Services.AddOptions<ForgeProvisioningOptions>()
            .BindConfiguration("Forge:Provisioning")
            .Validate(options => !options.Enabled ||
                (!string.IsNullOrWhiteSpace(options.UserPoolId) && !string.IsNullOrWhiteSpace(options.Region) &&
                 options.UserPoolId.StartsWith(options.Region + "_", StringComparison.Ordinal) &&
                 builder.Configuration["Forge:Oidc:Authority"]?.TrimEnd('/') ==
                     $"https://cognito-idp.{options.Region}.amazonaws.com/{options.UserPoolId}"),
                "Provisioning must use the same Cognito user pool as token validation.")
            .ValidateOnStart();
        builder.Services.AddSingleton<Amazon.CognitoIdentityProvider.IAmazonCognitoIdentityProvider>(services =>
        {
            var options = services.GetRequiredService<Microsoft.Extensions.Options.IOptions<ForgeProvisioningOptions>>().Value;
            return new Amazon.CognitoIdentityProvider.AmazonCognitoIdentityProviderClient(
                new Amazon.CognitoIdentityProvider.AmazonCognitoIdentityProviderConfig
                {
                    RegionEndpoint = Amazon.RegionEndpoint.GetBySystemName(options.Region),
                    MaxErrorRetry = 2,
                    Timeout = TimeSpan.FromSeconds(15),
                });
        });
        builder.Services.AddScoped<CognitoUserProvisioningService>();
{{- end }}
{{- if model.manifest.has_messaging }}
        builder.Services.Configure<ForgeOutboxOptions>(builder.Configuration.GetSection(ForgeOutboxOptions.SectionName));
{{- end }}
{{- if model.manifest.database != null }}
        // -- PostgreSQL (connection, password rotation, readiness check) ------------------------
        builder.Services.AddForgeDatabase<{{ model.names.dot_net_class_name }}DbContext>(builder.Configuration);
{{- end }}

        // -- OpenTelemetry Tracing --------------------------------------------------------
{{ if model.manifest.observability == null || model.manifest.observability.open_telemetry_enabled }}
        builder.Services.AddForgeTracing(builder.Configuration, builder.Environment);
{{ end }}

        // -- FluentValidation -------------------------------------------------------------
{{ if model.manifest.validation == null || model.manifest.validation.fluent_validation_enabled }}
        builder.Services.AddForgeValidation();
{{ end }}

        // -- API Versioning ---------------------------------------------------------------
        builder.Services.AddForgeVersioning();

        // -- HTTP Context + DelegatingHandlers --------------------------------------------
        builder.Services.AddHttpContextAccessor();
{{ if model.manifest.observability == null || model.manifest.observability.correlation_id_enabled }}
        builder.Services.AddTransient<CorrelationIdHandler>();
{{ end }}
{{ if model.manifest.observability == null || model.manifest.observability.serilog_enabled }}
        builder.Services.AddTransient<HttpLoggingHandler>();
{{ end }}
        builder.Services.AddTransient<ExternalAuthHandler>();
        builder.Services.AddTransient<JwtPropagationHandler>();
        builder.Services.AddSingleton<IForgeHashingService, ForgeHashingService>();
{{- if !model.manifest.tenant_ready }}
        builder.Services.AddScoped<ITenantContext, TenantContext>();
{{- else }}
        builder.Services.AddPervaxisTenantRepositories<{{ model.names.dot_net_class_name }}DbContext>();
{{- end }}
{{- if model.manifest.has_messaging }}
        builder.Services.AddScoped<IOutboxPublisher, OutboxPublisher>();
        builder.Services.AddHostedService<OutboxRelayService>();
{{- end }}

        // External (third-party) client: sends only its own ExternalServices:ApiKey, and only to ExternalServices:BaseUrl.
        // It never forwards the caller's token. Use IForgeInternalHttpClient to call Pervaxis services as the caller.
        builder.Services.AddOptions<ForgeExternalServicesOptions>()
            .BindConfiguration(ForgeExternalServicesOptions.SectionName);
        builder.Services.AddHttpClient<IForgeExternalHttpClient, ForgeExternalHttpClient>(client =>
        {
            var baseUrl = builder.Configuration[$"{ForgeExternalServicesOptions.SectionName}:BaseUrl"];
            if (!string.IsNullOrEmpty(baseUrl))
                client.BaseAddress = new Uri(baseUrl);
        })
        // No automatic redirects: they are followed below ExternalAuthHandler and would carry the API key to
        // whatever host the redirect names. A 3xx is returned to the caller, who decides whether to follow it.
        .ConfigurePrimaryHttpMessageHandler(() => new SocketsHttpHandler { AllowAutoRedirect = false })
{{- if model.manifest.observability == null || model.manifest.observability.correlation_id_enabled }}
        .AddHttpMessageHandler<CorrelationIdHandler>()
{{- end }}
        .AddHttpMessageHandler<ExternalAuthHandler>()
{{- if model.manifest.observability == null || model.manifest.observability.serilog_enabled }}
        .AddHttpMessageHandler<HttpLoggingHandler>()
{{- end }}
{{- if model.manifest.resilience == null || model.manifest.resilience.retry_enabled || model.manifest.resilience.circuit_breaker_enabled || model.manifest.resilience.timeout_enabled }}
        .AddForgeResilience(builder.Configuration.GetSection("Resilience:External"))
{{- end }};

        builder.Services.AddSwaggerGen(options =>
        {
            options.SwaggerDoc("v1", new OpenApiInfo
            {
                Title = "{{ model.names.dot_net_class_name }} API",
                Version = "v1",
                Description = "Versioned REST API for the {{ model.manifest.product }} {{ model.manifest.service_name }} service.",
            });
        });
        builder.Services.AddHealthChecks();

        var app = builder.Build();

        // -- Middleware pipeline (order is critical) ------------------------------------------
        // 1. Correlation ID first -- establishes request identity for all downstream
{{ if model.manifest.observability == null || model.manifest.observability.correlation_id_enabled }}
        app.UseMiddleware<CorrelationIdMiddleware>();
{{ end }}
        // 2. JWT propagation -- extracts Bearer token before downstream middleware runs
        app.UseMiddleware<JwtPropagationMiddleware>();
        // 3. Exception handler third -- catches errors from all downstream middleware
        app.UseMiddleware<ExceptionHandlerMiddleware>();
        // 4. Security headers -- applies to all responses including error responses
        app.UseMiddleware<SecurityHeadersMiddleware>();

        if (app.Environment.IsDevelopment() || app.Configuration.GetValue<bool>("Forge:EnableSwagger"))
        {
            app.UseSwagger();
            app.UseSwaggerUI(options =>
            {
                options.SwaggerEndpoint("/swagger/v1/swagger.json", "{{ model.names.dot_net_class_name }} API v1");
            });
        }

        app.UseHttpsRedirection();
        app.UseResponseCompression();
        // Request audit log: one entry per request, including requests that throw (Forge:AuditLogging:Enabled).
        // Business actions with target IDs (who changed which record) are not covered here; see docs/BACKLOG.md.
        var auditLogging = app.Configuration.GetSection(ForgeAuditLoggingOptions.SectionName)
            .Get<ForgeAuditLoggingOptions>() ?? new ForgeAuditLoggingOptions();
        if (auditLogging.Enabled)
        {
            app.UseMiddleware<RequestAuditMiddleware>();
        }
        app.UseCors(ForgeUiCorsPolicy);
        app.UseAuthentication();
{{- if model.manifest.tenant_ready }}
        // Tenant resolution: after authentication (the claim is trusted only once the token is validated), before authorization.
        app.UsePervaxisClaimsTenancy();
{{- end }}
        app.UseAuthorization();
        // Rate limiting runs after authentication so per-user limits partition by the authenticated
        // user. Before authentication the user is unknown and every caller falls back to the IP partition.
        app.UseRateLimiter();
        // Output caching runs after authentication, tenancy, authorization and rate limiting, so a cached
        // response is never served to a caller who would be rejected. Off unless Forge:OutputCaching:Enabled is true.
        if (outputCaching.Enabled)
        {
            app.UseOutputCache();
        }
{{- if has_sanitization }}
        // Input sanitization (see DeveloperReference/Sanitization.md).
        // 1. JSON bodies are capped at Genesis:Sanitization:MaxInputLength (413), so no string exceeds the sanitizer's limit.
        app.UseMiddleware<JsonBodyLimitMiddleware>();
        // 2. Cleans every string in JSON POST, PUT and PATCH bodies, including nested values, but only when
        //    Genesis:Sanitization:EnableMiddleware is true. Off by default: it changes every field of every request.
        app.UseGenesisSanitization();
{{- end }}
        // Health checks are anonymous -- load balancers must reach them without an API key.
        // /health is liveness: it never touches the database, so a short database outage does not restart healthy containers.
        // /health/ready is readiness: it runs the checks tagged "ready" (the database check when a database is configured).
        app.MapHealthChecks("/health", new HealthCheckOptions { Predicate = _ => false }).AllowAnonymous(){{ if model.manifest.tenant_ready }}.WithTenantExempt(){{ end }};
        app.MapHealthChecks("/health/ready", new HealthCheckOptions { Predicate = check => check.Tags.Contains("ready") }).AllowAnonymous(){{ if model.manifest.tenant_ready }}.WithTenantExempt(){{ end }};
        app.MapControllers().RequireAuthorization();

        await app.RunAsync();

    }
}
