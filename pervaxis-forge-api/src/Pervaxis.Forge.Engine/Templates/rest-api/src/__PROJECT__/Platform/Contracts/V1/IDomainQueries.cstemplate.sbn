namespace Pervaxis.Forge.Contracts.V1;

/// <summary>Read-only LINQ queries through the host's tenant-aware EF context. Never disable tenant query filters.</summary>
public interface IDomainQueries
{
    /// <summary>Returns an untracked query for an entity registered by an EF configuration in this assembly.</summary>
    IQueryable<TEntity> Query<TEntity>() where TEntity : class;
}
