using {{ model.names.namespace }}.Infrastructure.Extensions;
using {{ model.names.namespace }}.Infrastructure.Http;
using {{ model.names.namespace }}.Services;

namespace {{ model.names.namespace }}.Extensions;

public static class ServiceCollectionExtensions
{
    public static IServiceCollection Add{{ model.names.dot_net_class_name }}Services(
        this IServiceCollection services,
        IConfiguration configuration)
    {
        services.AddScoped<I{{ model.names.dot_net_class_name }}, {{ model.names.dot_net_class_name }}Service>();

        // HTTP client with full DelegatingHandler chain:
        // CorrelationId → JwtPropagation → HttpLogging → Resilience (retry + circuit breaker + timeout)
        services.AddHttpClient("forge-resilience")
            .AddHttpMessageHandler<CorrelationIdHandler>()
            .AddHttpMessageHandler<JwtPropagationHandler>()
            .AddHttpMessageHandler<HttpLoggingHandler>()
            .AddForgeResilience(configuration.GetSection("Resilience:Default"));

        return services;
    }
}
