{{ if !model.manifest.multi_tenancy }}
using System.Reflection;
using Microsoft.EntityFrameworkCore;
using {{ model.names.namespace }}.Infrastructure.Tenancy;
using {{ model.names.namespace }}.Models.Tenancy;

namespace {{ model.names.namespace }}.Data;

public partial class {{ model.names.dot_net_class_name }}DbContext : DbContext
{
    private readonly ITenantContext _tenantContext;

    public {{ model.names.dot_net_class_name }}DbContext(
        DbContextOptions<{{ model.names.dot_net_class_name }}DbContext> options,
        ITenantContext tenantContext)
        : base(options)
    {
        _tenantContext = tenantContext;
    }

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
        base.OnModelCreating(modelBuilder);

        // Domain teams add an IEntityTypeConfiguration<T> class next to their entity
        // (for example under Domains/Billing/Data). Every one in this project is picked up here,
        // so nobody edits this file to add a table.
        modelBuilder.ApplyConfigurationsFromAssembly(typeof({{ model.names.dot_net_class_name }}DbContext).Assembly);

        // Apply global query filter to all ITenantEntity types
        foreach (var entityType in modelBuilder.Model.GetEntityTypes())
        {
            if (typeof(ITenantEntity).IsAssignableFrom(entityType.ClrType))
            {
                var method = typeof({{ model.names.dot_net_class_name }}DbContext)
                    .GetMethod(nameof(ApplyTenantFilter),
                        BindingFlags.NonPublic | BindingFlags.Instance)!
                    .MakeGenericMethod(entityType.ClrType);
                method.Invoke(this, [modelBuilder]);
            }
        }
    }

    private void ApplyTenantFilter<TEntity>(ModelBuilder modelBuilder)
        where TEntity : class, ITenantEntity
    {
        modelBuilder.Entity<TEntity>()
            .HasQueryFilter(e => _tenantContext.TenantId == null || e.TenantId == _tenantContext.TenantId);
    }

    public override async Task<int> SaveChangesAsync(
        CancellationToken cancellationToken = default)
    {
        var tenantId = _tenantContext.TenantId;

        var newTenantEntities = ChangeTracker.Entries<ITenantEntity>()
            .Where(e => e.State == EntityState.Added)
            .ToList();

        if (newTenantEntities.Count > 0)
        {
            if (string.IsNullOrEmpty(tenantId))
                throw new InvalidOperationException(
                    "A TenantId is required to persist tenant-scoped entities. " +
                    "Ensure the X-Tenant-ID header is present on the request.");

            foreach (var entry in newTenantEntities)
                entry.Entity.TenantId = tenantId;
        }

        return await base.SaveChangesAsync(cancellationToken);
    }
}
{{ else }}
using Microsoft.EntityFrameworkCore;
using Pervaxis.Core.Abstractions.MultiTenancy;
using Pervaxis.Core.Data.EntityFrameworkCore;

namespace {{ model.names.namespace }}.Data;

/// <summary>
/// Tenant-isolated data context. Entities that derive from <c>TenantEntity&lt;TId&gt;</c> are filtered by the
/// current tenant on every read, stamped on insert, and protected on update and delete by the composite
/// <c>(TenantId, Id)</c> key. Entities that are shared by all tenants must carry <c>[SharedEntity]</c>.
/// Register this context with AddDbContext only (never AddDbContextPool).
/// </summary>
public partial class {{ model.names.dot_net_class_name }}DbContext : TenantDbContext
{
    public {{ model.names.dot_net_class_name }}DbContext(
        DbContextOptions<{{ model.names.dot_net_class_name }}DbContext> options,
        ITenantContext tenantContext)
        : base(options, tenantContext)
    {
    }

    protected override void OnTenantModelCreating(ModelBuilder modelBuilder)
    {
        // Domain teams add an IEntityTypeConfiguration<T> class next to their entity
        // (for example under Domains/Billing/Data). Every one in this project is picked up here,
        // so nobody edits this file to add a table. Relationships between tenant-owned entities use
        // a tenant-inclusive foreign key: HasForeignKey("TenantId", "ParentId").
        modelBuilder.ApplyConfigurationsFromAssembly(typeof({{ model.names.dot_net_class_name }}DbContext).Assembly);
    }
}
{{ end }}
