namespace {{ model.names.namespace }}.Data.Tenancy;

/// <summary>
/// The first tenant of this service, generated by Forge. It is seeded into the tenants table by the
/// <c>AddTenants</c> migration and is the only tenant in single-tenant mode.
/// </summary>
/// <remarks>
/// Do not change these values after the migration has run: existing rows are tagged with this tenant id.
/// <c>Forge:Tenant:DefaultTenantId</c> in appsettings.json holds the same id.
/// </remarks>
public static class TenantDefaults
{
    /// <summary>The id of the first tenant.</summary>
    public const string DefaultTenantId = "{{ model.default_tenant_id }}";

    /// <summary>The initial name of the first tenant. Rename it through the tenant management API.</summary>
    public const string DefaultTenantName = "{{ model.manifest.product }}";

    /// <summary>The creation time recorded for the first tenant.</summary>
    public static readonly DateTimeOffset SeededAt = DateTimeOffset.Parse("{{ model.default_tenant_seeded_at }}", System.Globalization.CultureInfo.InvariantCulture);
}
{{ end }}
