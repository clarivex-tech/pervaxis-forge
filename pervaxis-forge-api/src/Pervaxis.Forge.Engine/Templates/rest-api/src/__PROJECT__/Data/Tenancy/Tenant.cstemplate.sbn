using Pervaxis.Core.Abstractions.MultiTenancy;
using Pervaxis.Core.Data.EntityFrameworkCore;

namespace {{ model.names.namespace }}.Data.Tenancy;

/// <summary>
/// The tenant master table: one row per customer of this service. Platform code; manage rows through the
/// tenant management API (<c>api/v1/tenants</c>), not directly.
/// </summary>
/// <remarks>
/// A tenant is not owned by a tenant, so it is a <see cref="SharedEntityAttribute">shared entity</see>.
/// Requests for a tenant whose <see cref="Status"/> is not <see cref="TenantStatus.Active"/> are rejected with 403.
/// </remarks>
[SharedEntity]
public sealed class Tenant
{
    /// <summary>Maximum length of <see cref="Name"/>.</summary>
    public const int NameMaxLength = 200;

    /// <summary>The tenant identifier. This is the value of the <c>tenant_id</c> token claim in multi-tenant mode.</summary>
    public Guid Id { get; set; }

    /// <summary>The display name, for example the customer's company name.</summary>
    public string Name { get; set; } = string.Empty;

    /// <summary>The lifecycle status. Only <see cref="TenantStatus.Active"/> tenants are served.</summary>
    public TenantStatus Status { get; set; } = TenantStatus.Active;

    /// <summary>When the tenant was created.</summary>
    public DateTimeOffset CreatedAt { get; set; }

    /// <summary>When the tenant was last changed.</summary>
    public DateTimeOffset UpdatedAt { get; set; }
}
{{ end }}
