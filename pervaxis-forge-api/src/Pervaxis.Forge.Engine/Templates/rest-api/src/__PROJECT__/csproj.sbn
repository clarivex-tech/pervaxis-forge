<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <RootNamespace>{{ model.names.namespace }}</RootNamespace>
    <AssemblyName>{{ model.names.namespace }}</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="AWSSDK.SecretsManager" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Cross-cutting concerns -->
{{ if model.manifest.resilience == null || model.manifest.resilience.retry_enabled || model.manifest.resilience.circuit_breaker_enabled || model.manifest.resilience.timeout_enabled }}
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
{{ end }}
{{ if model.manifest.observability == null || model.manifest.observability.serilog_enabled }}
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="AWS.Logger.SeriLog" />
{{ end }}
{{ if model.manifest.validation == null || model.manifest.validation.fluent_validation_enabled }}
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
{{ end }}
{{ if model.manifest.observability == null || model.manifest.observability.open_telemetry_enabled }}
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
{{ end }}
    <PackageReference Include="Asp.Versioning.Http" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="BCrypt.Net-Next" />
{{- if model.manifest.has_messaging }}
    <PackageReference Include="AWSSDK.SQS" />
{{- end }}
{{- for module in model.selected_modules }}
    <PackageReference Include="{{ module.package_name }}" />
{{- end }}
  </ItemGroup>

</Project>
