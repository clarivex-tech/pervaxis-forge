using System.Text.Json;
using Amazon.SecretsManager;
using Amazon.SecretsManager.Model;
using Npgsql;

namespace {{ model.names.namespace }}.Infrastructure.Database;

/// <summary>
/// Reads the database user name and password from AWS Secrets Manager and combines them with the
/// connection settings from configuration (host, database, port, SSL).
///
/// Expected secret value (this is the format of RDS-managed and standard rotation secrets):
/// <c>{"username": "app_user", "password": "..."}</c>
/// Other keys in the secret are ignored.
/// </summary>
public sealed class DatabaseCredentialsReader(
    IAmazonSecretsManager client,
    string secretId,
    NpgsqlConnectionStringBuilder baseSettings)
{
    public async Task<NpgsqlConnectionStringBuilder> ReadAsync(CancellationToken cancellationToken)
    {
        var response = await client.GetSecretValueAsync(new GetSecretValueRequest
        {
            SecretId = secretId,
            VersionStage = "AWSCURRENT"
        }, cancellationToken).ConfigureAwait(false);

        var settings = new NpgsqlConnectionStringBuilder(baseSettings.ConnectionString);
        ApplyCredentials(settings, response.SecretString);
        return settings;
    }

    public static void ApplyCredentials(NpgsqlConnectionStringBuilder connection, string? secret)
    {
        ArgumentNullException.ThrowIfNull(connection);

        try
        {
            using var document = JsonDocument.Parse(secret ?? "{}");
            var root = document.RootElement;

            if (root.ValueKind != JsonValueKind.Object
                || !root.TryGetProperty("username", out var username)
                || !root.TryGetProperty("password", out var password)
                || username.ValueKind != JsonValueKind.String
                || password.ValueKind != JsonValueKind.String
                || string.IsNullOrWhiteSpace(username.GetString())
                || string.IsNullOrWhiteSpace(password.GetString()))
            {
                throw new InvalidOperationException("The database secret requires 'username' and 'password' text values.");
            }

            connection.Username = username.GetString();
            connection.Password = password.GetString();
        }
        catch (JsonException)
        {
            // Never include the secret text in the message.
            throw new InvalidOperationException("The database secret is not valid JSON.");
        }
    }

    /// <summary>
    /// Returns the new password. Only the password may change while the service runs.
    /// If the user name or any other setting changed, a restart is required, so this throws.
    /// </summary>
    public static string GetRefreshedPassword(
        NpgsqlConnectionStringBuilder original,
        NpgsqlConnectionStringBuilder refreshed)
    {
        ArgumentNullException.ThrowIfNull(original);
        ArgumentNullException.ThrowIfNull(refreshed);

        var originalCopy = new NpgsqlConnectionStringBuilder(original.ConnectionString);
        var refreshedCopy = new NpgsqlConnectionStringBuilder(refreshed.ConnectionString);
        originalCopy.Remove("Password");
        refreshedCopy.Remove("Password");

        if (!originalCopy.EquivalentTo(refreshedCopy))
        {
            throw new InvalidOperationException(
                "Database connection settings changed (for example the user name). Restart the service to load them.");
        }

        return refreshed.Password!;
    }
}
{{ end }}
