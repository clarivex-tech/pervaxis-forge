using Microsoft.EntityFrameworkCore;
using Pervaxis.Forge.Contracts.V1;
using {{ model.names.namespace }}.Data;

namespace {{ model.names.namespace }}.Infrastructure.Domains;

/// <summary>Adapts the host data context without exposing its implementation to business slices.</summary>
public sealed class DomainQueries({{ model.names.dot_net_class_name }}DbContext db) : IDomainQueries
{
    public IQueryable<TEntity> Query<TEntity>() where TEntity : class => db.Set<TEntity>().AsNoTracking();
}
