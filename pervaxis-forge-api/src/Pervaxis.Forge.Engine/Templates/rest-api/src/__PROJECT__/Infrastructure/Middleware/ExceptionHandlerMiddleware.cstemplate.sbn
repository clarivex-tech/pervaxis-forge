using System.Text.Json;
using Microsoft.AspNetCore.Mvc;
using Microsoft.Extensions.Options;
using {{ model.names.namespace }}.Common;
using {{ model.names.namespace }}.Infrastructure.Exceptions;
using {{ model.names.namespace }}.Models.Configuration;
using {{ model.names.namespace }}.Services;
{{- has_resilience = model.manifest.resilience == null || model.manifest.resilience.retry_enabled || model.manifest.resilience.circuit_breaker_enabled || model.manifest.resilience.timeout_enabled }}
{{- has_validation = model.manifest.validation == null || model.manifest.validation.fluent_validation_enabled }}
{{- if has_resilience }}
using Polly.CircuitBreaker;
{{- end }}
{{- if model.manifest.tenant_ready }}
using Microsoft.EntityFrameworkCore;
using Pervaxis.Core.Exceptions.Exceptions;
{{- end }}

namespace {{ model.names.namespace }}.Infrastructure.Middleware;

public sealed class ExceptionHandlerMiddleware
{
    private readonly RequestDelegate _next;
    private readonly ILogger<ExceptionHandlerMiddleware> _logger;
    private readonly IHostEnvironment _environment;
    private readonly IOptions<ForgeResilienceOptions> _resilienceOptions;

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        WriteIndented = false
    };

    public ExceptionHandlerMiddleware(
        RequestDelegate next,
        ILogger<ExceptionHandlerMiddleware> logger,
        IHostEnvironment environment,
        IOptions<ForgeResilienceOptions> resilienceOptions)
    {
        _next = next;
        _logger = logger;
        _environment = environment;
        _resilienceOptions = resilienceOptions;
    }

    public async Task InvokeAsync(HttpContext context)
    {
        try
        {
            await _next(context).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            if (context.Response.HasStarted)
            {
                throw;
            }

            var errorId = Guid.NewGuid().ToString();
            var correlationId = context.Items["CorrelationId"]?.ToString() ?? string.Empty;

            var problemDetails = MapException(ex, errorId, correlationId);

            LogException(ex, errorId, correlationId, problemDetails.Status ?? 500);

{{- if has_resilience }}
            if (ex is BrokenCircuitException)
            {
                context.Response.Headers["Retry-After"] =
                    _resilienceOptions.Value.CircuitBreakerBreakDurationSeconds.ToString();
            }
{{- end }}

            context.Response.Clear();
            context.Response.StatusCode = problemDetails.Status ?? 500;
            context.Response.ContentType = "application/problem+json";

            var responseBody = new
            {
                type = problemDetails.Type,
                title = problemDetails.Title,
                status = problemDetails.Status,
                detail = problemDetails.Detail,
                errorId,
                correlationId
            };

            await context.Response.WriteAsync(
                JsonSerializer.Serialize(responseBody, JsonOptions)).ConfigureAwait(false);
        }
    }

    private ProblemDetails MapException(Exception ex, string errorId, string correlationId)
    {
        return ex switch
        {
{{- if has_validation }}
            FluentValidation.ValidationException fluentEx => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Validation Error",
                Status = StatusCodes.Status400BadRequest,
                Detail = string.Join(" ", fluentEx.Errors.Select(e => e.ErrorMessage))
            },
{{- end }}

            ConfirmationRequiredException confirmEx => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Confirmation Required",
                Status = StatusCodes.Status400BadRequest,
                Detail = confirmEx.Message
            },

            SlugConflictException conflictEx => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Conflict",
                Status = StatusCodes.Status409Conflict,
                Detail = conflictEx.Message
            },

            KeyNotFoundException notFoundEx => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Not Found",
                Status = StatusCodes.Status404NotFound,
                Detail = notFoundEx.Message
            },

            UnauthorizedAccessException unauthorizedEx => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Forbidden",
                Status = StatusCodes.Status403Forbidden,
                Detail = unauthorizedEx.Message
            },

{{- if model.manifest.tenant_ready }}
            // Tenant isolation. The 404 is identical for "missing" and "belongs to another tenant".
            TenantResourceNotFoundException => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Not Found",
                Status = StatusCodes.Status404NotFound,
                Detail = "The requested resource was not found."
            },
            TenantContextRequiredException or TenantIsolationViolationException => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Forbidden",
                Status = StatusCodes.Status403Forbidden,
                Detail = "A valid tenant is required for this operation."
            },
            DbUpdateConcurrencyException => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Conflict",
                Status = StatusCodes.Status409Conflict,
                Detail = "The resource was changed by another request. Reload it and try again."
            },
{{- end }}
            // Thrown by the server for malformed or oversized requests (for example a body above the size limit).
            Microsoft.AspNetCore.Http.BadHttpRequestException badRequestEx => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = badRequestEx.StatusCode == StatusCodes.Status413PayloadTooLarge ? "Payload Too Large" : "Bad Request",
                Status = badRequestEx.StatusCode,
                Detail = badRequestEx.StatusCode == StatusCodes.Status413PayloadTooLarge
                    ? "The request body is too large."
                    : "The request could not be read."
            },
            OperationCanceledException => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Client Disconnected",
                Status = 499,
                Detail = "Client disconnected"
            },

{{- if has_resilience }}
            BrokenCircuitException => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Service Unavailable",
                Status = StatusCodes.Status503ServiceUnavailable,
                Detail = "Service temporarily unavailable"
            },
{{- end }}

            _ => new ProblemDetails
            {
                Type = "https://tools.ietf.org/html/rfc7807",
                Title = "Internal Server Error",
                Status = StatusCodes.Status500InternalServerError,
                Detail = _environment.IsDevelopment()
                    ? $"{ex.GetType().Name}: {ex.Message}\n{ex.StackTrace}"
                    : "An unexpected error occurred."
            }
        };
    }

    private void LogException(Exception ex, string errorId, string correlationId, int statusCode)
    {
        switch (statusCode)
        {
            case 400:
                _logger.LogInformation(
                    ex,
                    "Validation error {ErrorId} {CorrelationId} {StatusCode}",
                    errorId, correlationId, statusCode);
                break;

            case 403:
                _logger.LogWarning(
                    ex,
                    "Forbidden {ErrorId} {CorrelationId} {StatusCode}",
                    errorId, correlationId, statusCode);
                break;

            case 404:
                _logger.LogInformation(
                    ex,
                    "Not found {ErrorId} {CorrelationId} {StatusCode}",
                    errorId, correlationId, statusCode);
                break;

            case 413:
                _logger.LogWarning(
                    ex,
                    "Request body too large {ErrorId} {CorrelationId} {StatusCode}",
                    errorId, correlationId, statusCode);
                break;

            case 499:
                _logger.LogWarning(
                    ex,
                    "Client disconnected {ErrorId} {CorrelationId} {StatusCode}",
                    errorId, correlationId, statusCode);
                break;

            case 503:
                _logger.LogWarning(
                    ex,
                    "Circuit breaker open {ErrorId} {CorrelationId} {StatusCode}",
                    errorId, correlationId, statusCode);
                break;

            default:
                _logger.LogError(
                    ex,
                    "Unhandled exception {ErrorId} {CorrelationId} {StatusCode}",
                    errorId, correlationId, statusCode);
                break;
        }
    }
}
