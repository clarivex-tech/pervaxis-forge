{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
{{ if model.manifest.observability == null || model.manifest.observability.serilog_enabled }}
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "CloudWatch": {
      "LogGroup": "/pervaxis/{{ model.manifest.vertical_slug }}/{{ model.manifest.service_name }}",
      "LogStreamPrefix": "{{ model.manifest.service_name }}"
    }
  },
{{ end }}
  "Resilience": {
    "Default": {
      "MaxRetryAttempts": 3,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerSamplingWindowSeconds": 30,
      "CircuitBreakerBreakDurationSeconds": 60,
      "TimeoutSeconds": 30
    },
    "External": {
      "MaxRetryAttempts": 2,
      "CircuitBreakerFailureThreshold": 3,
      "CircuitBreakerSamplingWindowSeconds": 60,
      "CircuitBreakerBreakDurationSeconds": 120,
      "TimeoutSeconds": 15
    }
  },
  "ExternalServices": {
    "BaseUrl": ""
  },
{{ if model.manifest.observability == null || model.manifest.observability.open_telemetry_enabled }}
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
{{ end }}
  "Forge": {
    "ServiceName": "{{ model.manifest.service_name }}",
    "EnableSwagger": false,
    "Oidc": {
{{- if model.manifest.cognito != null }}
      "Provider": "Cognito",
      "Authority": "{{ model.manifest.cognito.authority }}",
      "Audience": "",
      "ClientIds": [{{ for client_id in model.manifest.cognito.client_ids }}"{{ client_id }}"{{ if !for.last }}, {{ end }}{{ end }}],
{{- else }}
      "Provider": "Auth0",
      "Authority": "",
      "Audience": "",
      "ClientIds": [],
{{- end }}
      "Domain": ""
    },
    "Authentication": {
      "ApiKey": "",
{{- if model.manifest.cognito != null }}
      "Scheme": "{{ model.manifest.cognito.scheme }}"
{{- else }}
      "Scheme": "ApiKey"
{{- end }}
    },
    "Authorization": {
{{- if model.manifest.cognito != null }}
      "AdminGroup": "{{ model.manifest.cognito.admin_group }}",
{{- else }}
      "AdminGroup": "Admin",
{{- end }}
      "GroupClaimType": "",
{{- if model.manifest.tenant_ready }}
      "PlatformAdminGroup": "PlatformAdmin",
{{- end }}
      "Policies": {}
    },
{{- if model.manifest.tenant_ready }}
    "Tenant": {
      "Mode": "{{ if model.manifest.multi_tenancy }}MultiTenant{{ else }}SingleTenant{{ end }}",
      "DefaultTenantId": "{{ model.default_tenant_id }}",
      "ClaimType": "tenant_id",
      "EnableDirectoryChecks": true,
      "DirectoryCacheTtl": "00:01:00"
    },
{{- else }}
    "Tenant": {
      "Required": false
    },
{{- end }}
{{- if model.manifest.has_messaging }}
    "Outbox": {
      "MaxRetries": 5,
      "PollingIntervalSeconds": 10
    },
{{- end }}
    "Secrets": {
      "UseSecretsManager": false,
      "SecretId": "",
      "ApiKeySecretKey": "Forge:Authentication:ApiKey"
    },
{{- if model.manifest.database != null }}
    "Database": {
      "SecretId": "",
      "RootCertificate": ""
    },
{{- end }}
    "AuditLogging": {
      "Enabled": true
    },
    "DataClassification": {
      "DefaultClassification": "internal",
      "SensitiveKeys": ["password", "secret", "token", "apiKey", "email", "phone"]
    },
    "OutputCaching": {
      "Enabled": false,
      "DefaultExpirationSeconds": 60
    },
    "RateLimiting": {
      "Enabled": false,
      "PermitLimit": 100,
      "WindowMinutes": 1
    },
    "Cors": {
      "AllowedOrigins": ["http://localhost:4200"]
    }
  }{{ if model.manifest.database != null }},
  "ConnectionStrings": {
    "Default": ""
  }{{ end }}{{ genesis_count = 0 }}{{ for module in model.selected_modules }}{{ if module.uses_genesis_section }}{{ genesis_count = genesis_count + 1 }}{{ else }},
  "{{ module.display_name }}": {}{{ end }}{{ end }}{{ if genesis_count > 0 }},
  "Genesis": {
{{- genesis_index = 0 }}{{ for module in model.selected_modules }}{{ if module.uses_genesis_section }}{{ if genesis_index > 0 }},{{ end }}{{ genesis_index = genesis_index + 1 }}
{{- if module.display_name == "OData" }}
    "OData": {
      "MaxTop": 100,
      "DefaultPageSize": 20,
      "MaxExpandDepth": 2,
      "MaxFilterDepth": 3,
      "MaxOrderByProperties": 3,
      "EnableCount": true,
      "MaxQueryComplexityScore": 50
    }
{{- else if module.display_name == "Sanitization" }}
    "Sanitization": {
      "DefaultProfile": "PlainText",
      "MaxInputLength": 1000000,
      "EnableMiddleware": false,
      "MiddlewareExcludedRoutes": []
    }
{{- else }}
    "{{ module.display_name }}": {}
{{- end }}{{ end }}{{ end }}
  }{{ end }}
}
