using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Data.Entities;

namespace Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Data.Repositories;

/// <summary>Every operation enforces both current tenant and current human owner inside the database query.</summary>
public interface IWorkspaceTaskRepository
{
    Task<WorkspaceTask> CreateAsync(string title, string? description, bool isCompleted, DateTime now, CancellationToken cancellationToken);
    Task<IReadOnlyList<WorkspaceTask>> ListAsync(int page, int pageSize, CancellationToken cancellationToken);
    Task<WorkspaceTask?> GetAsync(Guid id, CancellationToken cancellationToken);
    Task<WorkspaceTask?> UpdateAsync(Guid id, Guid expectedVersion, string title, string? description, bool isCompleted, DateTime now, CancellationToken cancellationToken);
    Task<bool> DeleteAsync(Guid id, Guid expectedVersion, CancellationToken cancellationToken);
}
