using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Contracts.Responses;
using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Data.Entities;

namespace Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Mappings;

public static class WorkspaceTaskMappings
{
    public static WorkspaceTaskResponse ToResponse(this WorkspaceTask entity) => new()
    {
        Id = entity.Id, Title = entity.Title, Description = entity.Description, IsCompleted = entity.IsCompleted,
        CreatedAt = entity.CreatedAt, UpdatedAt = entity.UpdatedAt, Version = entity.Version,
    };
}
{{ end }}
