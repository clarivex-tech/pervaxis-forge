using FluentValidation;
using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Constants;
using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Contracts.Requests;

namespace Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Validators;

public sealed class UpdateWorkspaceTaskValidator : AbstractValidator<UpdateWorkspaceTaskRequest>
{
    public UpdateWorkspaceTaskValidator()
    {
        RuleFor(request => request.Title).NotEmpty().MaximumLength(WorkspaceTaskConstants.TitleLength);
        RuleFor(request => request.Description).MaximumLength(WorkspaceTaskConstants.DescriptionLength);
    }
}
{{ end }}
