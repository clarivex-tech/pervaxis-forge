using FluentValidation;
using Microsoft.EntityFrameworkCore;
using Pervaxis.Core.Abstractions.Data;
using Pervaxis.Core.Exceptions.Exceptions;
using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Contracts;
using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Contracts.Requests;
using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Contracts.Responses;
using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Data.Repositories;
using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Mappings;
using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Validators;

namespace Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Services;

public sealed class WorkspaceTaskService(
    IWorkspaceTaskRepository repository, IUnitOfWork unitOfWork, TimeProvider clock,
    CreateWorkspaceTaskValidator createValidator, UpdateWorkspaceTaskValidator updateValidator,
    ListWorkspaceTasksValidator listValidator) : IWorkspaceTaskService
{
    public async Task<WorkspaceTaskResponse> CreateAsync(CreateWorkspaceTaskRequest request, CancellationToken cancellationToken)
    {
        try
        {
            await createValidator.ValidateAndThrowAsync(request, cancellationToken);
            var task = await repository.CreateAsync(request.Title.Trim(), Normalize(request.Description), request.IsCompleted,
                clock.GetUtcNow().UtcDateTime, cancellationToken);
            await unitOfWork.CommitAsync(cancellationToken);
            return task.ToResponse();
        }
        catch
        {
            await unitOfWork.RollbackAsync(CancellationToken.None);
            throw;
        }
    }

    public async Task<WorkspaceTaskPageResponse> ListAsync(ListWorkspaceTasksRequest request, CancellationToken cancellationToken)
    {
        await listValidator.ValidateAndThrowAsync(request, cancellationToken);
        var rows = await repository.ListAsync(request.Page, request.PageSize, cancellationToken);
        return new WorkspaceTaskPageResponse
        {
            Items = rows.Take(request.PageSize).Select(row => row.ToResponse()).ToArray(),
            Page = request.Page, PageSize = request.PageSize, HasMore = rows.Count > request.PageSize,
        };
    }

    public async Task<WorkspaceTaskResponse?> GetAsync(Guid id, CancellationToken cancellationToken)
        => (await repository.GetAsync(id, cancellationToken))?.ToResponse();

    public async Task<WorkspaceTaskResponse?> UpdateAsync(Guid id, Guid expectedVersion, UpdateWorkspaceTaskRequest request, CancellationToken cancellationToken)
    {
        try
        {
            await updateValidator.ValidateAndThrowAsync(request, cancellationToken);
            var task = await repository.UpdateAsync(id, expectedVersion, request.Title.Trim(), Normalize(request.Description),
                request.IsCompleted, clock.GetUtcNow().UtcDateTime, cancellationToken);
            if (task is null)
            {
                await unitOfWork.RollbackAsync(CancellationToken.None);
                return null;
            }
            await unitOfWork.CommitAsync(cancellationToken);
            return task.ToResponse();
        }
        catch (Exception exception) when (exception is DbUpdateConcurrencyException or TenantResourceNotFoundException)
        {
            // Discard failed tracked state before the ownership-scoped database recheck.
            await unitOfWork.RollbackAsync(CancellationToken.None);
            if (await repository.GetAsync(id, cancellationToken) is null) return null;
            throw new WorkspaceTaskPreconditionException();
        }
        catch
        {
            await unitOfWork.RollbackAsync(CancellationToken.None);
            throw;
        }
    }

    public async Task<bool> DeleteAsync(Guid id, Guid expectedVersion, CancellationToken cancellationToken)
    {
        try
        {
            if (!await repository.DeleteAsync(id, expectedVersion, cancellationToken))
            {
                await unitOfWork.RollbackAsync(CancellationToken.None);
                return false;
            }
            await unitOfWork.CommitAsync(cancellationToken);
            return true;
        }
        catch (Exception exception) when (exception is DbUpdateConcurrencyException or TenantResourceNotFoundException)
        {
            await unitOfWork.RollbackAsync(CancellationToken.None);
            if (await repository.GetAsync(id, cancellationToken) is null) return false;
            throw new WorkspaceTaskPreconditionException();
        }
        catch
        {
            await unitOfWork.RollbackAsync(CancellationToken.None);
            throw;
        }
    }

    private static string? Normalize(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
{{ end }}
