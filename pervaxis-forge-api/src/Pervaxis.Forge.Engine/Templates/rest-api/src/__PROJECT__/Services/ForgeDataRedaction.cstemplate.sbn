using System.Text.RegularExpressions;
using Microsoft.Extensions.Options;
using {{ model.names.namespace }}.Models.Configuration;

namespace {{ model.names.namespace }}.Services;

public sealed class ForgeDataRedaction
{
    private static readonly Regex EmailPattern = new(
        @"(?<local>[^@\s]+)@(?<domain>[^@\s]+\.[^@\s]+)",
        RegexOptions.Compiled | RegexOptions.CultureInvariant | RegexOptions.IgnoreCase);

    private static readonly Regex PhonePattern = new(
        @"\b(?:\+?\d{1,3}[-. ]?)?(?:\(?\d{3}\)?[-. ]?)?\d{3}[-. ]?\d{4}\b",
        RegexOptions.Compiled | RegexOptions.CultureInvariant);

    private readonly IOptionsMonitor<ForgeDataClassificationOptions> _options;

    public ForgeDataRedaction(IOptionsMonitor<ForgeDataClassificationOptions> options)
    {
        _options = options;
    }

    public string Classification => _options.CurrentValue.DefaultClassification;

    public string Redact(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return value;
        }

        value = EmailPattern.Replace(value, "***@***");
        value = PhonePattern.Replace(value, "[redacted-phone]");
        return value;
    }

    public bool IsSensitiveKey(string key)
    {
        var keys = _options.CurrentValue.SensitiveKeys;
        return keys.Any(candidate => string.Equals(candidate, key, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>Replacement written to logs in place of a sensitive value.</summary>
    public const string RedactedValue = "[redacted]";

    /// <summary>
    /// True when a log property name contains any configured sensitive key, so
    /// <c>UserEmail</c>, <c>RefreshToken</c> and <c>ApiKeyHash</c> all match.
    /// </summary>
    public bool IsSensitiveName(string name)
    {
        if (string.IsNullOrEmpty(name))
        {
            return false;
        }

        var keys = _options.CurrentValue.SensitiveKeys;
        return keys.Any(candidate => !string.IsNullOrEmpty(candidate)
            && name.Contains(candidate, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Redaction for log values: masks email addresses only. The phone pattern in <see cref="Redact"/>
    /// also matches digit runs inside IDs and GUIDs, which would make logs useless for tracing,
    /// so log properties named like phone numbers are masked by name instead.
    /// </summary>
    public string RedactLogValue(string value)
    {
        if (string.IsNullOrEmpty(value) || !value.Contains('@'))
        {
            return value;
        }

        return EmailPattern.Replace(value, "***@***");
    }
}
