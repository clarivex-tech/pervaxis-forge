using System.Reflection;
using System.Text.Json;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;

namespace {{ model.names.namespace }}.Controllers;

/// <summary>
/// HORIZONTAL: Scaffold metadata endpoint.
/// Returns information about the Forge engine version, modules, and print timestamp.
/// </summary>
[ApiController]
[Route("meta")]
[AllowAnonymous]
public sealed class MetaController : ControllerBase
{
    private static readonly Lazy<JsonDocument> PrintMetadata = new(() =>
    {
        var assembly = Assembly.GetExecutingAssembly();
        var resourceName = assembly.GetManifestResourceNames()
            .FirstOrDefault(n => n.EndsWith(".forge-print.json"));

        if (resourceName is null)
            return JsonDocument.Parse("{}");

        using var stream = assembly.GetManifestResourceStream(resourceName)!;
        return JsonDocument.Parse(stream);
    });

    [HttpGet]
    [ProducesResponseType(typeof(object), StatusCodes.Status200OK)]
    public IActionResult GetMeta()
    {
        return Ok(PrintMetadata.Value.RootElement);
    }
}
