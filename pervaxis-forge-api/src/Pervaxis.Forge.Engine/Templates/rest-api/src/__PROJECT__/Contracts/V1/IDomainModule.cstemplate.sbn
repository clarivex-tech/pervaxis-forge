using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace Pervaxis.Forge.Contracts.V1;

/// <summary>Host contract version 1. Implement inside a feature with a public parameterless constructor.</summary>
public interface IDomainModule
{
    /// <summary>Registers this feature's services and options. Must not build a service provider or perform I/O.</summary>
    void Register(IServiceCollection services, IConfiguration configuration);
}
