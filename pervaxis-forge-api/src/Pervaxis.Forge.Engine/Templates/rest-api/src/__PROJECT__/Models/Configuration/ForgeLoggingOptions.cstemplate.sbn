namespace {{ model.names.namespace }}.Models.Configuration;

public sealed class ForgeLoggingOptions
{
    public const string SectionName = "Serilog";

    public string ServiceName { get; set; } = "{{ model.manifest.service_name }}";

    public CloudWatchOptions? CloudWatch { get; set; }
}

public sealed class CloudWatchOptions
{
    public string LogGroup { get; set; } = "/pervaxis/{{ model.manifest.vertical_slug }}/{{ model.manifest.service_name }}";

    public string? LogStreamPrefix { get; set; }
}
