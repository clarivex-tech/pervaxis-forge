using {{ model.names.namespace }}.Extensions;
using {{ model.names.namespace }}.Infrastructure.Extensions;
using {{ model.names.namespace }}.Infrastructure.Http;
using {{ model.names.namespace }}.Infrastructure.Middleware;
using {{ model.names.namespace }}.Infrastructure.Security;
{{- if !model.manifest.multi_tenancy }}
using {{ model.names.namespace }}.Infrastructure.Tenancy;
{{- else }}
using Pervaxis.Core.Data.EntityFrameworkCore;
using Pervaxis.Core.MultiTenancy;
{{- end }}
{{- if model.manifest.has_messaging }}
using {{ model.names.namespace }}.Infrastructure.Outbox;
{{- end }}
using {{ model.names.namespace }}.Models.Configuration;
{{- for module in model.selected_modules }}
using {{ module.package_name }}.Extensions;
{{- end }}
using Amazon.Extensions.NETCore.Setup;
using Amazon.SecretsManager;
using Microsoft.AspNetCore.Authentication;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.ResponseCompression;
using Microsoft.AspNetCore.OutputCaching;
using Microsoft.AspNetCore.RateLimiting;
using Microsoft.EntityFrameworkCore;
using Microsoft.OpenApi.Models;
using System.Diagnostics;
using System.Threading.RateLimiting;
{{- if model.manifest.database != null }}
using {{ model.names.namespace }}.Data;
using {{ model.names.namespace }}.Infrastructure.Database;
{{- end }}
using Microsoft.AspNetCore.Diagnostics.HealthChecks;
using {{ model.names.namespace }}.Auth;
using {{ model.names.namespace }}.Services;

var builder = WebApplication.CreateBuilder(args);

// -- Structured Logging (Serilog + CloudWatch) ------------------------------------------
{{ if model.manifest.observability == null || model.manifest.observability.serilog_enabled }}
builder.AddForgeSerilog();
{{ end }}

builder.Services.Add{{ model.names.dot_net_class_name }}Services(builder.Configuration);
builder.Services.AddDefaultAWSOptions(builder.Configuration.GetAWSOptions());
builder.Services.AddAWSService<IAmazonSecretsManager>();
{{- for module in model.selected_modules }}
builder.Services.{{ module.di_extension_name }}(
    builder.Configuration.GetSection("{{ module.name }}"));
{{- end }}

builder.Services.AddControllers();
builder.Services.AddEndpointsApiExplorer();
builder.Services.AddResponseCompression(options =>
{
    options.EnableForHttps = true;
});

// -- Configuration options --------------------------------------------------------
builder.Services.Configure<ForgeResilienceOptions>(
    builder.Configuration.GetSection(ForgeResilienceOptions.SectionName));
builder.Services.AddOptions<ForgeDataClassificationOptions>()
    .BindConfiguration(ForgeDataClassificationOptions.SectionName);
builder.Services.AddOptions<ForgeAuthenticationOptions>()
    .BindConfiguration(ForgeAuthenticationOptions.SectionName);
builder.Services.AddOptions<ForgeSecretsOptions>()
    .BindConfiguration(ForgeSecretsOptions.SectionName);
builder.Services.AddSingleton<ForgeDataRedaction>();
builder.Services.AddOptions<ForgeOutputCachingOptions>()
    .BindConfiguration(ForgeOutputCachingOptions.SectionName);
builder.Services.AddOutputCache();
builder.Services.AddOptions<ForgeRateLimitingOptions>()
    .BindConfiguration(ForgeRateLimitingOptions.SectionName);
builder.Services.AddRateLimiter(limiterOptions =>
{
    var rateLimiting = builder.Configuration.GetSection(ForgeRateLimitingOptions.SectionName)
        .Get<ForgeRateLimitingOptions>() ?? new ForgeRateLimitingOptions();

    if (rateLimiting.Enabled)
    {
        limiterOptions.RejectionStatusCode = StatusCodes.Status429TooManyRequests;
        limiterOptions.GlobalLimiter = PartitionedRateLimiter.Create<HttpContext, string>(context =>
            RateLimitPartition.GetFixedWindowLimiter(
                partitionKey: context.User.Identity?.Name ?? context.Connection.RemoteIpAddress?.ToString() ?? "anonymous",
                factory: _ => new FixedWindowRateLimiterOptions
                {
                    PermitLimit = Math.Max(1, rateLimiting.PermitLimit),
                    Window = TimeSpan.FromMinutes(Math.Max(1, rateLimiting.WindowMinutes)),
                    QueueLimit = 0,
                    AutoReplenishment = true,
                }));
    }
});

const string ForgeUiCorsPolicy = "ForgeUi";
builder.Services.AddCors(options =>
{
    var allowedOrigins = builder.Configuration
        .GetSection("Forge:Cors:AllowedOrigins")
        .Get<string[]>() ?? ["http://localhost:4200"];

    options.AddPolicy(ForgeUiCorsPolicy, policy => policy
        .WithOrigins(allowedOrigins)
        .AllowAnyHeader()
        .AllowAnyMethod());
});
// -- Authentication (API Key + optional JWT/OIDC) ------------------------------------
builder.Services.AddForgeAuthentication(builder.Configuration);
builder.Services.Configure<ForgeOidcOptions>(builder.Configuration.GetSection(ForgeOidcOptions.SectionName));
{{- if !model.manifest.multi_tenancy }}
builder.Services.Configure<ForgeTenantOptions>(builder.Configuration.GetSection(ForgeTenantOptions.SectionName));
{{- else }}
// -- Multi-tenancy: tenant comes only from the validated access token claim (never from a header) --
builder.Services.AddPervaxisClaimsMultiTenancy(options => builder.Configuration.GetSection("Forge:Tenant").Bind(options));
{{- end }}
{{- if model.manifest.has_messaging }}
builder.Services.Configure<ForgeOutboxOptions>(builder.Configuration.GetSection(ForgeOutboxOptions.SectionName));
{{- end }}
{{- if model.manifest.database != null }}
// -- PostgreSQL (connection, password rotation, readiness check) ------------------------
builder.Services.AddForgeDatabase<{{ model.names.dot_net_class_name }}DbContext>(builder.Configuration);
{{- end }}

// -- OpenTelemetry Tracing --------------------------------------------------------
{{ if model.manifest.observability == null || model.manifest.observability.open_telemetry_enabled }}
builder.Services.AddForgeTracing(builder.Configuration);
{{ end }}

// -- FluentValidation -------------------------------------------------------------
{{ if model.manifest.validation == null || model.manifest.validation.fluent_validation_enabled }}
builder.Services.AddForgeValidation();
{{ end }}

// -- API Versioning ---------------------------------------------------------------
builder.Services.AddForgeVersioning();

// -- HTTP Context + DelegatingHandlers --------------------------------------------
builder.Services.AddHttpContextAccessor();
{{ if model.manifest.observability == null || model.manifest.observability.correlation_id_enabled }}
builder.Services.AddTransient<CorrelationIdHandler>();
{{ end }}
{{ if model.manifest.observability == null || model.manifest.observability.serilog_enabled }}
builder.Services.AddTransient<HttpLoggingHandler>();
{{ end }}
builder.Services.AddTransient<ExternalAuthHandler>();
builder.Services.AddTransient<JwtPropagationHandler>();
builder.Services.AddSingleton<IForgeHashingService, ForgeHashingService>();
{{- if !model.manifest.multi_tenancy }}
builder.Services.AddScoped<ITenantContext, TenantContext>();
{{- else if model.manifest.database != null }}
builder.Services.AddPervaxisTenantRepositories<{{ model.names.dot_net_class_name }}DbContext>();
{{- end }}
{{- if model.manifest.has_messaging }}
builder.Services.AddScoped<IOutboxPublisher, OutboxPublisher>();
builder.Services.AddHostedService<OutboxRelayService>();
{{- end }}

builder.Services.AddHttpClient<IForgeExternalHttpClient, ForgeExternalHttpClient>(client =>
{
    var baseUrl = builder.Configuration["ExternalServices:BaseUrl"];
    if (!string.IsNullOrEmpty(baseUrl))
        client.BaseAddress = new Uri(baseUrl);
})
.AddHttpMessageHandler<CorrelationIdHandler>()
.AddHttpMessageHandler<ExternalAuthHandler>()
.AddHttpMessageHandler<HttpLoggingHandler>()
.AddForgeResilience(builder.Configuration.GetSection("Resilience:External"));

builder.Services.AddSwaggerGen(options =>
{
    options.SwaggerDoc("v1", new OpenApiInfo
    {
        Title = "{{ model.names.dot_net_class_name }} API",
        Version = "v1",
        Description = "Versioned REST API for the {{ model.manifest.product }} {{ model.manifest.service_name }} service.",
    });
});
builder.Services.AddHealthChecks();

var app = builder.Build();

// -- Middleware pipeline (order is critical) ------------------------------------------
// 1. Correlation ID first -- establishes request identity for all downstream
{{ if model.manifest.observability == null || model.manifest.observability.correlation_id_enabled }}
app.UseMiddleware<CorrelationIdMiddleware>();
{{ end }}
// 2. JWT propagation -- extracts Bearer token before downstream middleware runs
app.UseMiddleware<JwtPropagationMiddleware>();
// 3. Exception handler third -- catches errors from all downstream middleware
app.UseMiddleware<ExceptionHandlerMiddleware>();
// 4. Security headers -- applies to all responses including error responses
app.UseMiddleware<SecurityHeadersMiddleware>();

if (app.Environment.IsDevelopment() || app.Configuration.GetValue<bool>("Forge:EnableSwagger"))
{
    app.UseSwagger();
    app.UseSwaggerUI(options =>
    {
        options.SwaggerEndpoint("/swagger/v1/swagger.json", "{{ model.names.dot_net_class_name }} API v1");
    });
}

app.UseHttpsRedirection();
app.UseResponseCompression();
app.UseOutputCache();
app.Use(async (context, next) =>
{
    var startedAt = Stopwatch.GetTimestamp();
    await next();

    var elapsedMs = Stopwatch.GetElapsedTime(startedAt).TotalMilliseconds;
    var actor = context.User.Identity?.IsAuthenticated == true
        ? context.User.Identity?.Name ?? "authenticated-user"
        : "anonymous";

    app.Logger.LogInformation(
        "Audit event {AuditAction} {Method} {Path} {StatusCode} {ElapsedMs}ms {Actor} {CorrelationId}",
        "request",
        context.Request.Method,
        context.Request.Path.Value,
        context.Response.StatusCode,
        elapsedMs,
        actor,
        context.Items["CorrelationId"]?.ToString() ?? context.TraceIdentifier);
});
app.UseCors(ForgeUiCorsPolicy);
app.UseAuthentication();
{{- if model.manifest.multi_tenancy }}
// Tenant resolution: after authentication (the claim is trusted only once the token is validated), before authorization.
app.UsePervaxisClaimsTenancy();
{{- end }}
app.UseAuthorization();
// Rate limiting runs after authentication so per-user limits partition by the authenticated
// user. Before authentication the user is unknown and every caller falls back to the IP partition.
app.UseRateLimiter();
// Health checks are anonymous -- load balancers must reach them without an API key.
// /health is liveness: it never touches the database, so a short database outage does not restart healthy containers.
// /health/ready is readiness: it runs the checks tagged "ready" (the database check when a database is configured).
app.MapHealthChecks("/health", new HealthCheckOptions { Predicate = _ => false }).AllowAnonymous(){{ if model.manifest.multi_tenancy }}.WithTenantExempt(){{ end }};
app.MapHealthChecks("/health/ready", new HealthCheckOptions { Predicate = check => check.Tags.Contains("ready") }).AllowAnonymous(){{ if model.manifest.multi_tenancy }}.WithTenantExempt(){{ end }};
app.MapControllers().RequireAuthorization();

app.Run();

