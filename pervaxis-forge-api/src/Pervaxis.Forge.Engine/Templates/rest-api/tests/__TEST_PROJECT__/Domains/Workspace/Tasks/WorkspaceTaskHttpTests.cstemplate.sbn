using System.Net;
using System.Net.Http.Json;
using System.Text.Json;
using Pervaxis.Forge.Testing.V1;
using Pervaxis.Forge.Reference.Domains.Workspace.Tasks.Contracts.Responses;
using Xunit;

namespace Pervaxis.Forge.Reference.Domains.Workspace.Tests;

public sealed class WorkspaceTaskHttpTests(WorkspaceTaskHost host) : IClassFixture<WorkspaceTaskHost>
{
    private const string Route = "/api/v1/workspace/tasks";
    private static string User() => Guid.NewGuid().ToString("D");

    [Fact]
    public async Task Crud_IsDiscovered_Validated_AndVersioned()
    {
        var token = host.Token(User());
        using var created = await host.SendAsync("POST", Route, token, new { title = "  First task  ", description = " detail ", isCompleted = false });
        Assert.Equal(HttpStatusCode.Created, created.StatusCode);
        Assert.True(created.Headers.CacheControl?.NoStore);
        var task = (await created.Content.ReadFromJsonAsync<WorkspaceTaskResponse>())!;
        var location = Route + "/" + task.Id;
        Assert.Equal(location, created.Headers.Location!.OriginalString);
        Assert.Equal("\"" + task.Version.ToString("D") + "\"", created.Headers.ETag!.Tag);
        Assert.Equal("First task", task.Title);
        Assert.Equal("detail", task.Description);
        Assert.Equal(DateTimeKind.Utc, task.CreatedAt.Kind);
        Assert.Equal(task.CreatedAt, task.UpdatedAt);
        using var read = await host.SendAsync("GET", location, token);
        Assert.Equal(HttpStatusCode.OK, read.StatusCode);
        using var changed = await host.SendAsync("PUT", location, token,
            new { title = "Done", description = (string?)null, isCompleted = true }, created.Headers.ETag.Tag);
        Assert.Equal(HttpStatusCode.OK, changed.StatusCode);
        var updated = (await changed.Content.ReadFromJsonAsync<WorkspaceTaskResponse>())!;
        Assert.True(updated.IsCompleted);
        Assert.Equal(task.CreatedAt, updated.CreatedAt);
        Assert.True(updated.UpdatedAt >= task.UpdatedAt);
        Assert.NotEqual(task.Version, updated.Version);
        using var stale = await host.SendAsync("DELETE", location, token, etag: created.Headers.ETag.Tag);
        Assert.Equal(HttpStatusCode.PreconditionFailed, stale.StatusCode);
        using var deleted = await host.SendAsync("DELETE", location, token, etag: changed.Headers.ETag!.Tag);
        Assert.Equal(HttpStatusCode.NoContent, deleted.StatusCode);
        using var missing = await host.SendAsync("GET", location, token);
        Assert.Equal(HttpStatusCode.NotFound, missing.StatusCode);
        using var json = JsonDocument.Parse(await created.Content.ReadAsStringAsync());
        Assert.Equal(new[] { "createdAt", "description", "id", "isCompleted", "title", "updatedAt", "version" },
            json.RootElement.EnumerateObject().Select(property => property.Name).Order());
    }

    [Fact]
    public async Task OtherUsersAndTenants_Are404_EvenAsPlatformAdmin()
    {
        var owner = User();
        var token = host.Token(owner);
        using var create = await host.SendAsync("POST", Route, token, new { title = "Private" });
        var task = (await create.Content.ReadFromJsonAsync<WorkspaceTaskResponse>())!;
        foreach (var other in new[] { host.Token(User()), host.Token(owner, DomainTestDatabase.TenantB) })
        {
            foreach (var method in new[] { "GET", "PUT", "DELETE" })
            {
                using var response = await host.SendAsync(method, Route + "/" + task.Id, other,
                    method == "PUT" ? new { title = "Stolen", isCompleted = false } : null,
                    "\"" + Guid.NewGuid().ToString("D") + "\"");
                Assert.Equal(HttpStatusCode.NotFound, response.StatusCode);
            }
            using var list = await host.SendAsync("GET", Route, other);
            var page = (await list.Content.ReadFromJsonAsync<WorkspaceTaskPageResponse>())!;
            Assert.DoesNotContain(page.Items, item => item.Id == task.Id);
        }
    }

    [Theory]
    [InlineData("{}")]
    [InlineData("{\"title\":\" \"}")]
    [InlineData("{\"title\":\"ok\",\"ownerSubject\":\"attacker\"}")]
    [InlineData("{\"title\":\"ok\",\"tenantId\":\"attacker\"}")]
    public async Task InvalidOrInjectedBodies_Are400(string json)
    {
        var body = JsonSerializer.Deserialize<JsonElement>(json);
        using var response = await host.SendAsync("POST", Route, host.Token(User()), body);
        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
    }

    [Fact]
    public async Task LimitsAndSqlMetacharacters_AreHandledAsData()
    {
        var token = host.Token(User());
        foreach (var body in new[] { new { title = new string('x', 201), description = "" }, new { title = "ok", description = new string('d', 4001) } })
        {
            using var invalid = await host.SendAsync("POST", Route, token, body);
            Assert.Equal(HttpStatusCode.BadRequest, invalid.StatusCode);
        }
        const string input = "' OR 1=1; DROP TABLE workspace_tasks;--";
        using var create = await host.SendAsync("POST", Route, token, new { title = input });
        Assert.Equal(HttpStatusCode.Created, create.StatusCode);
        using var list = await host.SendAsync("GET", Route, token);
        Assert.Equal(input, (await list.Content.ReadFromJsonAsync<WorkspaceTaskPageResponse>())!.Items.Single().Title);
        Assert.DoesNotContain(host.Database.Sql.Commands, sql => sql.Contains(input, StringComparison.Ordinal));
    }

    [Theory]
    [InlineData("?page=0")]
    [InlineData("?page=10001")]
    [InlineData("?pageSize=0")]
    [InlineData("?pageSize=101")]
    [InlineData("?pageSize=not-an-integer")]
    [InlineData("?ownerSubject=another-user")]
    [InlineData("?tenantId=another-tenant")]
    [InlineData("?sort=Title;DROP")]
    public async Task InvalidPaginationOrSelectors_Are400(string query)
    {
        using var response = await host.SendAsync("GET", Route + query, host.Token(User()));
        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
    }

    [Fact]
    public async Task Pagination_IsBoundedAndDeterministic()
    {
        var token = host.Token(User());
        for (var i = 0; i < 5; i++)
        {
            using var create = await host.SendAsync("POST", Route, token, new { title = "Task " + i });
            Assert.Equal(HttpStatusCode.Created, create.StatusCode);
        }
        var ids = new List<Guid>();
        for (var page = 1; page <= 3; page++)
        {
            using var response = await host.SendAsync("GET", Route + "?page=" + page + "&pageSize=2", token);
            var result = (await response.Content.ReadFromJsonAsync<WorkspaceTaskPageResponse>())!;
            Assert.Equal(page, result.Page);
            Assert.Equal(2, result.PageSize);
            Assert.Equal(page < 3, result.HasMore);
            ids.AddRange(result.Items.Select(item => item.Id));
        }
        Assert.Equal(5, ids.Distinct().Count());
        using var repeat = await host.SendAsync("GET", Route + "?pageSize=2", token);
        Assert.Equal(ids.Take(2), (await repeat.Content.ReadFromJsonAsync<WorkspaceTaskPageResponse>())!.Items.Select(item => item.Id));
    }

    [Theory]
    [InlineData(null, 428)]
    [InlineData("*", 400)]
    [InlineData("W/\"00000000-0000-0000-0000-000000000001\"", 400)]
    [InlineData("not-a-guid", 400)]
    [InlineData("\"00000000-0000-0000-0000-000000000001\",\"00000000-0000-0000-0000-000000000002\"", 400)]
    public async Task Preconditions_AreStrict(string? value, int expected)
    {
        var token = host.Token(User());
        using var created = await host.SendAsync("POST", Route, token, new { title = "Conditional" });
        var task = (await created.Content.ReadFromJsonAsync<WorkspaceTaskResponse>())!;
        using var response = await host.SendAsync("PUT", Route + "/" + task.Id, token, new { title = "Update", isCompleted = true }, value);
        Assert.Equal(expected, (int)response.StatusCode);
    }

    [Fact]
    public async Task AnonymousMachineIdTokenAndApiKey_CannotUseTasks()
    {
        foreach (var token in new string?[] { null, host.Token(User(), machine: true), host.Token(User(), tokenUse: "id") })
        {
            using var response = await host.SendAsync("GET", Route, token);
            Assert.Equal(HttpStatusCode.Unauthorized, response.StatusCode);
        }
        using var request = new HttpRequestMessage(HttpMethod.Get, Route);
        request.Headers.Add("X-Api-Key", "workspace-local-test-key");
        using var key = await host.Client.SendAsync(request);
        Assert.Equal(HttpStatusCode.Forbidden, key.StatusCode);
        using var suspended = await host.SendAsync("GET", Route, host.Token(User(), DomainTestDatabase.Suspended));
        Assert.Equal(HttpStatusCode.Forbidden, suspended.StatusCode);
    }
}
{{ end }}
