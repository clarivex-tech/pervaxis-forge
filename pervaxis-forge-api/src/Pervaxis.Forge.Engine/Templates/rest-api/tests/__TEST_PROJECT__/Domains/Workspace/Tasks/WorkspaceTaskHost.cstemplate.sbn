using System.Net.Http.Headers;
using System.Security.Cryptography;
using System.Text.Json;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.TestHost;
using Microsoft.IdentityModel.JsonWebTokens;
using Microsoft.IdentityModel.Tokens;
using Pervaxis.Forge.Testing.V1;
using Xunit;

namespace Pervaxis.Forge.Reference.Domains.Workspace.Tests;

/// <summary>Real signed bearer tokens, MVC, automatic modules, shared EF context and tenant admission.</summary>
public sealed class WorkspaceTaskHost : IAsyncLifetime
{
    private readonly RSA _rsa = RSA.Create(2048);
    private WebApplication? _app;
    public DomainTestDatabase Database { get; } = new();
    public HttpClient Client { get; private set; } = null!;

    public async Task InitializeAsync()
    {
        _app = Database.CreateApplication(new RsaSecurityKey(_rsa) { KeyId = "workspace-test-key" });
        await _app.StartAsync();
        Client = _app.GetTestClient();
    }

    public string Token(string subject, string? tenant = null, bool machine = false, string tokenUse = "access")
    {
        var claims = new Dictionary<string, object>
        {
            ["sub"] = machine ? DomainTestDatabase.ClientId : subject,
            ["tenant_id"] = tenant ?? DomainTestDatabase.TenantA,
            ["token_use"] = tokenUse,
            ["client_id"] = DomainTestDatabase.ClientId,
            ["cognito:groups"] = new[] { "Admin", "PlatformAdmin" },
        };
        if (!machine) claims["username"] = subject;
        return new JsonWebTokenHandler().CreateToken(new SecurityTokenDescriptor
        {
            Issuer = DomainTestDatabase.Issuer,
            Claims = claims, Expires = DateTime.UtcNow.AddMinutes(10),
            SigningCredentials = new SigningCredentials(new RsaSecurityKey(_rsa) { KeyId = "workspace-test-key" }, SecurityAlgorithms.RsaSha256),
        });
    }

    public async Task<HttpResponseMessage> SendAsync(string method, string path, string? token, object? body = null, string? etag = null)
    {
        using var request = new HttpRequestMessage(new HttpMethod(method), path);
        if (token is not null) request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        if (body is not null) request.Content = new StringContent(JsonSerializer.Serialize(body), System.Text.Encoding.UTF8, "application/json");
        if (etag is not null) request.Headers.TryAddWithoutValidation("If-Match", etag);
        request.Headers.Add("X-Tenant-ID", DomainTestDatabase.TenantB); // Deliberately ignored by production admission.
        return await Client.SendAsync(request);
    }

    public async Task DisposeAsync()
    {
        Client.Dispose();
        if (_app is not null) await _app.DisposeAsync();
        Database.Dispose();
        _rsa.Dispose();
    }
}
{{ end }}
