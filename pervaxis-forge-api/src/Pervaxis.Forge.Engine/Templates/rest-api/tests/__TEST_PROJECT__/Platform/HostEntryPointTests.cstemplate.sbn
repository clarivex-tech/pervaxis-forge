using System.Net;

using Microsoft.AspNetCore.Authentication;

using Amazon.SecretsManager;
{{- if model.manifest.tenant_ready }}
using Amazon.CognitoIdentityProvider;
using Pervaxis.Core.Abstractions.MultiTenancy;
{{- end }}
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
using Moq;
using Xunit;

using {{ model.names.test_project_name }}.Platform.Fixtures;

namespace {{ model.names.test_project_name }}.Platform;

/// <summary>Exercises the real entry point and Platform host without using a database or cloud API.</summary>
public sealed class HostEntryPointTests
{
    [Fact]
    public async Task RealHostServesHealthAndMetaAndProtectsTenantAdministration()
    {
        var secrets = new Mock<IAmazonSecretsManager>(MockBehavior.Strict);
{{- if model.manifest.tenant_ready }}
        var cognito = new Mock<IAmazonCognitoIdentityProvider>(MockBehavior.Strict);
        var directory = new Mock<ITenantDirectory>(MockBehavior.Strict);
        directory.Setup(value => value.FindAsync(It.IsAny<TenantId>(), It.IsAny<CancellationToken>()))
            .ReturnsAsync((TenantId id, CancellationToken _) => new TenantDirectoryEntry(id, "Smoke tenant", TenantStatus.Active));
{{- end }}
        await using var factory = new WebApplicationFactory<Program>().WithWebHostBuilder(builder =>
        {
            // Development logging uses the console, never a CloudWatch sink.
            builder.UseEnvironment("Development");
            builder.ConfigureAppConfiguration((_, configuration) => configuration.AddInMemoryCollection(new Dictionary<string, string?>
            {
                ["ConnectionStrings:Default"] = "Host=127.0.0.1;Port=1;Database=unused;Username=unused;Password=unused;Pooling=false",
                ["Forge:Database:SecretId"] = "",
                ["Forge:Secrets:UseSecretsManager"] = "false",
                ["Forge:Provisioning:Enabled"] = "false",

                ["Forge:Tracing:OtlpEndpoint"] = "http://127.0.0.1:1",
            }));
            builder.ConfigureServices(services =>
            {
                services.RemoveAll<IAmazonSecretsManager>();
                services.AddSingleton(secrets.Object);
                services.AddAuthentication(options =>
                {
                    options.DefaultAuthenticateScheme = "EntryPointTest";
                    options.DefaultChallengeScheme = "EntryPointTest";
                }).AddScheme<AuthenticationSchemeOptions, EntryPointAuthenticationHandler>("EntryPointTest", _ => { });
{{- if model.manifest.tenant_ready }}
                services.RemoveAll<IAmazonCognitoIdentityProvider>();
                services.AddSingleton(cognito.Object);
                services.RemoveAll<ITenantDirectory>();
                services.AddSingleton(directory.Object);
{{- end }}
            });
        });
        using var client = factory.CreateClient(new WebApplicationFactoryClientOptions { BaseAddress = new Uri("https://localhost") });
        Assert.Equal(HttpStatusCode.OK, (await client.GetAsync("/health")).StatusCode);
        var meta = await client.GetAsync("/meta");
{{- if model.manifest.tenant_ready }}
        // Existing Core tenancy behavior guards /meta even though MVC marks it AllowAnonymous.
        Assert.Equal(HttpStatusCode.Unauthorized, meta.StatusCode);
{{- end }}
        client.DefaultRequestHeaders.Add("Entry-Test-User", "enabled");
        Assert.Equal(HttpStatusCode.OK, (await client.GetAsync("/meta")).StatusCode);
        client.DefaultRequestHeaders.Remove("Entry-Test-User");
{{- if model.manifest.tenant_ready }}
        Assert.Equal(HttpStatusCode.Unauthorized, (await client.GetAsync("/api/v1/tenants")).StatusCode);
        cognito.VerifyNoOtherCalls();
{{- end }}
        secrets.VerifyNoOtherCalls();
    }
}
{{ end }}
