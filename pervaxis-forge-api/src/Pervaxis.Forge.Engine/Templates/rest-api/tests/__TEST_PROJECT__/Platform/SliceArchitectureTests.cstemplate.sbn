using System.Text.RegularExpressions;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;


using NetArchTest.Rules;
using Xunit;
using {{ model.names.namespace }}.Platform.Data;
{{- if model.manifest.tenant_ready }}
using Pervaxis.Core.Data.EntityFrameworkCore;
{{- else }}
using {{ model.names.namespace }}.Platform.Infrastructure.Tenancy;
{{- end }}

namespace {{ model.names.test_project_name }}.Platform;

public sealed class SliceArchitectureTests
{
    [Fact]
    public void RuntimeHostNamespacesExpressOwnership()
    {
        var assembly = typeof({{ model.names.namespace }}.Platform.Hosting.ForgeHost).Assembly;
        var unexpected = assembly.GetTypes().Where(type => !string.IsNullOrEmpty(type.Namespace))
            .Select(type => type.Namespace!).Distinct().Where(ns =>
                !ns.StartsWith("{{ model.names.namespace }}.Platform.", StringComparison.Ordinal)
                && !ns.Contains(".Domains.", StringComparison.Ordinal)
                && ns != "Pervaxis.Forge.Contracts.V1"
                // Persisted CLR identities and EF history deliberately retain these namespaces.
                && ns != "{{ model.names.namespace }}.Data.Tenancy"
                && ns != "{{ model.names.namespace }}.Data.Outbox"
                && ns != "{{ model.names.namespace }}.Data.Migrations")
            .ToArray();
        Assert.Empty(unexpected);
    }

    [Fact]
    public void RuntimeHostDoesNotDependOnBusinessSlices()
    {
        var assembly = typeof({{ model.names.namespace }}.Platform.Hosting.ForgeHost).Assembly;
        var domains = assembly.GetTypes().Select(type => type.Namespace ?? "")
            .Select(ns => Regex.Match(ns, @"^(.+\.Domains\.[^.]+)(?:\.|$)"))
            .Where(match => match.Success).Select(match => match.Groups[1].Value).Distinct().ToArray();
        if (domains.Length == 0)
            return;
        var result = Types.InAssembly(assembly).That()
            .DoNotResideInNamespaceMatching(@".*\.Domains\..*")
            // EF tooling intentionally records business entity identities here.
            .And().DoNotResideInNamespace("{{ model.names.namespace }}.Data.Migrations")
            .Should().NotHaveDependencyOnAny(domains).GetResult();
        Assert.True(result.IsSuccessful, string.Join(", ", result.FailingTypeNames ?? []));

        foreach (var domain in domains)
        {
            var portable = Types.InAssembly(assembly).That().ResideInNamespace(domain)
                .Should().NotHaveDependencyOn("{{ model.names.namespace }}").GetResult();
            Assert.True(portable.IsSuccessful, string.Join(", ", portable.FailingTypeNames ?? []));
            var others = domains.Where(other => other != domain).ToArray();
            if (others.Length == 0)
                continue;
            var boundaries = Types.InAssembly(assembly).That().ResideInNamespace(domain)
                .Should().NotHaveDependencyOnAny(others).GetResult();
            Assert.True(boundaries.IsSuccessful, string.Join(", ", boundaries.FailingTypeNames ?? []));
        }
    }

    [Fact]
    public void BusinessControllersUseVersionedFeatureRoutes()
    {
        // Platform controllers intentionally retain /meta and /api/v1/tenants routes.
        foreach (var controller in typeof({{ model.names.namespace }}.Platform.Hosting.ForgeHost).Assembly.GetTypes().Where(type =>
            (type.Namespace ?? "").Contains(".Domains.", StringComparison.Ordinal) &&
            typeof(ControllerBase).IsAssignableFrom(type) && !type.IsAbstract))
        {
            var routes = controller.GetCustomAttributes(typeof(RouteAttribute), inherit: true).Cast<RouteAttribute>().ToArray();
            Assert.NotEmpty(routes);
            Assert.All(routes, route => Assert.Matches(@"^api/v(?:[1-9][0-9]*|\{version:apiVersion\})/[^/]+", route.Template));
        }
    }

    [Fact]
    public void PlatformModelMatchesPreservedMigrationSnapshot()
    {
        var options = new DbContextOptionsBuilder<{{ model.names.dot_net_class_name }}DbContext>()
            .UseNpgsql("Host=localhost;Database=model_check;Username=unused;Password=unused").Options;
{{- if model.manifest.tenant_ready }}
        using var db = new {{ model.names.dot_net_class_name }}DbContext(options, DesignTimeTenantContext.Instance);
{{- else }}
        using var db = new {{ model.names.dot_net_class_name }}DbContext(options, new ModelCheckTenant());
{{- end }}
        // Model-only operation: no database connection or AWS access.
        Assert.False(db.Database.HasPendingModelChanges(),
            "Append an intentional migration; moving files must not change the database model.");
{{- if model.manifest.tenant_ready }}
        Assert.Contains("20260101000000_AddTenants", db.Database.GetMigrations());
        Assert.Equal("{{ model.names.namespace }}.Data.Tenancy.Tenant",
            db.Model.FindEntityType(typeof({{ model.names.namespace }}.Data.Tenancy.Tenant))!.Name);
{{- end }}
    }
{{- if !model.manifest.tenant_ready }}
    private sealed class ModelCheckTenant : ITenantContext
    {
        public string? TenantId => null;
    }
{{- end }}
}
