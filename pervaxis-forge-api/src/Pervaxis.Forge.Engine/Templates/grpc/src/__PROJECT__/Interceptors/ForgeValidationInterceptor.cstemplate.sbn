using Grpc.Core;
using Grpc.Core.Interceptors;
using Microsoft.Extensions.Logging;

namespace {{ model.names.namespace }}.Interceptors;

// [1.3.1] Validates required proto fields at the gRPC boundary before the call reaches the service.
// Add your domain validation rules to Validate<TRequest> below — throw RpcException with
// StatusCode.InvalidArgument for missing/malformed fields, so callers get structured error details.
//
// Extend with FluentValidation by injecting IValidator<TRequest> and calling .Validate(request)
// inside Validate<TRequest> — see the developer guide for an example.
public sealed class ForgeValidationInterceptor : Interceptor
{
    private readonly ILogger<ForgeValidationInterceptor> _logger;

    public ForgeValidationInterceptor(ILogger<ForgeValidationInterceptor> logger)
    {
        _logger = logger;
    }

    public override async Task<TResponse> UnaryServerHandler<TRequest, TResponse>(
        TRequest request,
        ServerCallContext context,
        UnaryServerMethod<TRequest, TResponse> continuation)
    {
        Validate(request, context.Method);
        return await continuation(request, context).ConfigureAwait(false);
    }

    public override Task ServerStreamingServerHandler<TRequest, TResponse>(
        TRequest request,
        IServerStreamWriter<TResponse> responseStream,
        ServerCallContext context,
        ServerStreamingServerMethod<TRequest, TResponse> continuation)
    {
        Validate(request, context.Method);
        return continuation(request, responseStream, context);
    }

    private void Validate<TRequest>(TRequest request, string method)
    {
        if (request is null)
        {
            _logger.LogWarning("Null request received for {Method}", method);
            throw new RpcException(new Status(StatusCode.InvalidArgument, "Request must not be null."));
        }

        // TODO: Add field-level validation rules here.
        // Example — reject empty string fields:
        //
        // if (request is HelloRequest helloRequest)
        // {
        //     if (string.IsNullOrWhiteSpace(helloRequest.Name))
        //         throw new RpcException(new Status(StatusCode.InvalidArgument, "Name is required."));
        // }
        //
        // For complex validation, inject IValidator<TRequest> (FluentValidation) and call:
        //   var result = _validator.Validate(request);
        //   if (!result.IsValid)
        //       throw new RpcException(new Status(StatusCode.InvalidArgument, result.ToString()));
    }
}
