using Grpc.Core;
using Grpc.Core.Interceptors;
using System.Diagnostics;
using Microsoft.Extensions.Logging;

namespace {{ model.names.namespace }}.Services;

public sealed class ForgeGrpcInterceptor : Interceptor
{
    private readonly ILogger<ForgeGrpcInterceptor> _logger;

    public ForgeGrpcInterceptor(ILogger<ForgeGrpcInterceptor> logger)
    {
        _logger = logger;
    }

    public override async Task<TResponse> UnaryServerHandler<TRequest, TResponse>(
        TRequest request,
        ServerCallContext context,
        UnaryServerMethod<TRequest, TResponse> continuation)
    {
        var startedAt = Stopwatch.GetTimestamp();
        try
        {
            return await continuation(request, context);
        }
        finally
        {
            var elapsedMs = Stopwatch.GetElapsedTime(startedAt).TotalMilliseconds;
            _logger.LogInformation(
                "Audit event {AuditAction} {Method} {Peer} {StatusCode} {ElapsedMs}ms {TraceId}",
                "grpc-call",
                context.Method,
                context.Peer,
                context.Status.StatusCode,
                elapsedMs,
                context.GetHttpContext()?.TraceIdentifier ?? context.TraceId);
        }
    }
}
