{
  "Forge:Authentication": {
    "ApiKey": ""
  },
  "Forge:Resilience": {
    "Enabled": true,
    "RetryCount": 3,
    "RetryDelayMilliseconds": 1000,
    "TimeoutSeconds": 30
  },
  "Forge:Secrets": {
    "ApiKeySecretKey": "Forge:Authentication:ApiKey"
  },
  "Forge:DataClassification": {
    "DefaultLevel": "internal",
    "RedactionToken": "[REDACTED]"
  }
{{ if model.manifest.database != null }},
  "ConnectionStrings": {
    "Default": "Host=localhost;Database={{ model.names.database_schema }}_dev;Username=postgres;Password=postgres"
  }
{{ end }}
}
