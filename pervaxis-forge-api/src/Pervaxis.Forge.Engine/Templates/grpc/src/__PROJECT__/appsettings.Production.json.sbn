{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Forge:Authentication": {
    "ApiKey": ""
  },
  "Forge:Resilience": {
    "Enabled": true,
    "RetryCount": 3,
    "RetryDelayMilliseconds": 1000,
    "TimeoutSeconds": 30
  },
  "Forge:Shutdown": {
    "TimeoutSeconds": 30
  },
  "Forge:Secrets": {
    "UseSecretsManager": true,
    "ApiKeySecretKey": "Forge:Authentication:ApiKey"
  },
  "Forge:DataClassification": {
    "DefaultLevel": "internal",
    "RedactionToken": "[REDACTED]"
  }
{{ if model.manifest.database != null }},
  "ConnectionStrings": {
    "Default": ""
  }
{{ end }}
}
