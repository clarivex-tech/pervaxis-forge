// [10.5] Field-level comments are generated as stubs — replace with your domain descriptions.
// These comments drive API documentation tooling (grpc-gateway, protoc-gen-doc, etc.).

syntax = "proto3";

// [10.2] Versioned package name — bump to v2 only for breaking changes (field type change,
// field removal). Additive changes (new fields, new RPCs) do not require a version bump.
option csharp_namespace = "{{ model.names.namespace }}";

package {{ model.manifest.product | string.downcase }}.{{ model.manifest.service_name | string.downcase | string.replace "-" "_" }}.v1;

// [10.1] Hello is kept as the smoke-test RPC. Replace or extend with your domain RPCs.
// Commented CRUD scaffold below — uncomment and adapt to your domain entity.
service {{ model.names.dot_net_class_name }} {
  // Health smoke test — authenticated ping to verify the service is reachable.
  rpc Hello (HelloRequest) returns (HelloReply);

  // --- CRUD scaffold — uncomment and replace YourEntity with your domain entity name ---
  //
  // Retrieve a single record by its unique identifier.
  // rpc Get (GetRequest) returns (RecordResponse);
  //
  // Create a new record. Use an Idempotency-Key metadata header to prevent duplicates on retry.
  // rpc Create (CreateRequest) returns (RecordResponse);
  //
  // Update an existing record. Only the fields present in the request are changed (patch semantics).
  // rpc Update (UpdateRequest) returns (RecordResponse);
  //
  // Soft-delete a record. Returns NotFound if the record does not exist.
  // rpc Delete (DeleteRequest) returns (DeleteResponse);
  //
  // List records with cursor-based pagination. See ListRequest for page_token usage.
  // rpc List (ListRequest) returns (ListResponse);
}

// HelloRequest — replace with your domain request message.
message HelloRequest {
  // The caller's identity or display name (used for the smoke-test echo response).
  // Required. Max length: 100 characters.
  string name = 1;
}

// HelloReply — replace with your domain response message.
message HelloReply {
  // Echo of the name provided in HelloRequest, formatted as a greeting.
  string message = 1;
}

