using Grpc.Core;
using System.Diagnostics;
using System.Diagnostics.Metrics;

namespace {{ model.names.namespace }}.Services;

public sealed class {{ model.names.dot_net_class_name }}Impl : {{ model.names.dot_net_class_name }}.v1.{{ model.names.dot_net_class_name }}Base
{
    private static readonly ActivitySource _activitySource = new("{{ model.names.namespace }}");
    private static readonly Meter _meter = new("{{ model.names.namespace }}");
    private static readonly Counter<long> _rpcCounter = _meter.CreateCounter<long>("{{ model.manifest.service_name }}.rpc.calls");
    private static readonly Histogram<double> _rpcDuration = _meter.CreateHistogram<double>("{{ model.manifest.service_name }}.rpc.duration.ms");

    public override async Task<HelloReply> Hello(HelloRequest request, ServerCallContext context)
    {
        var startedAt = Stopwatch.GetTimestamp();
        var result = "success";
        using var activity = _activitySource.StartActivity("{{ model.manifest.service_name }}.hello");
        activity?.SetTag("rpc.system", "grpc");
        activity?.SetTag("rpc.method", "Hello");
        activity?.SetTag("rpc.service", "{{ model.names.dot_net_class_name }}");

        try
        {
            // Replace Task.Delay with your domain logic
            await Task.Delay(TimeSpan.Zero, context.CancellationToken).ConfigureAwait(false);

            return new HelloReply
            {
                Message = $"Hello {request.Name} from {{ model.names.dot_net_class_name }}"
            };
        }
        catch (OperationCanceledException)
        {
            // [1.3.2] Cancellation is not an error — do not increment error counters or mark span as failed
            result = "cancelled";
            throw;
        }
        catch (Exception ex)
        {
            // [5.1.1] Mark span as error so failed calls are visible in the tracing backend
            result = "error";
            activity?.SetStatus(ActivityStatusCode.Error, ex.Message);
            throw;
        }
        finally
        {
            _rpcCounter.Add(1, new TagList
            {
                { "rpc.method", "Hello" },
                { "result", result }
            });

            _rpcDuration.Record(Stopwatch.GetElapsedTime(startedAt).TotalMilliseconds, new TagList
            {
                { "rpc.method", "Hello" },
                { "result", result }
            });
        }
    }
}
