# [8.2] Use ARG to pin the base image version. Override at build time with:
#   docker build --build-arg DOTNET_VERSION=10.0.1 ...
# Dependabot can update this ARG automatically when a new patch ships.
ARG DOTNET_VERSION=10.0

FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION} AS base

# [8.1] Run as non-root for principle of least privilege
RUN adduser --disabled-password --gecos "" appuser

WORKDIR /app
# [8.5] Expose the port that Kestrel actually listens on (matches appsettings.json Kestrel config)
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src
COPY ["src/{{ model.names.namespace }}/{{ model.names.project_file }}", "src/{{ model.names.namespace }}/"]
RUN dotnet restore "src/{{ model.names.namespace }}/{{ model.names.project_file }}"
COPY . .
WORKDIR "/src/src/{{ model.names.namespace }}"
RUN dotnet build "{{ model.names.project_file }}" -c $BUILD_CONFIGURATION -o /app/build

FROM build AS publish
RUN dotnet publish "{{ model.names.project_file }}" -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# [8.1] Switch to non-root user before running the process
RUN chown -R appuser /app
USER appuser

# [8.3] Built-in health check so container orchestrators can detect unhealthy containers
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8080/healthz || exit 1

ENTRYPOINT ["dotnet", "{{ model.names.namespace }}.dll"]
