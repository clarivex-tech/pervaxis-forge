name: Build and Test

on:
  pull_request:
    branches: [main, develop]
    paths:
      - 'src/**'
      - '.github/workflows/build-test.yml'
  push:
    branches: [main, develop]
    paths:
      - 'src/**'
      - '.github/workflows/build-test.yml'

defaults:
  run:
    working-directory: src/{{ model.names.namespace }}

env:
  DOTNET_NOLOGO: true
  DOTNET_SKIP_FIRST_TIME_EXPERIENCE: true
  DOTNET_CLI_TELEMETRY_OPTOUT: true

jobs:
  build-test:
    name: Build and Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - uses: actions/setup-dotnet@v5
        with:
          dotnet-version: "10.x"

      - uses: actions/cache@v5
        with:
          path: ~/.nuget/packages
          key: ${{ runner.os }}-nuget-${{ hashFiles('**/*.csproj') }}
          restore-keys: ${{ runner.os }}-nuget-

      - run: dotnet restore "{{ model.names.project_file }}"

      - run: dotnet build "{{ model.names.project_file }}" --no-restore --configuration Release

      - run: dotnet test "../../tests/{{ model.names.namespace }}.Tests/{{ model.names.namespace }}.Tests.csproj" --no-build --configuration Release /p:CollectCoverage=true /p:CoverletOutputFormat=cobertura /p:Threshold=90 /p:ThresholdType=line /p:ThresholdStat=total
