# =============================================================================
# {{ model.names.namespace }} — Environment Variable Reference
# =============================================================================
# Copy this file to .env for local development (never commit .env to git).
# In production (AWS ECS/EKS), set these as task/pod environment variables or
# inject them from Secrets Manager via the Forge:Secrets provider.
#
# ASP.NET Core config keys use __ (double-underscore) as hierarchy separator
# when expressed as environment variables.
# e.g. "Forge:Authentication:ApiKey" → "Forge__Authentication__ApiKey"
# =============================================================================

# --------------- Authentication ---------------
# API key for inbound requests. In production, leave blank and use SecretsManager below.
Forge__Authentication__ApiKey=your-dev-api-key-here

# --------------- Secrets Manager ---------------
# Set to true in production to pull the API key from AWS Secrets Manager.
# When true, ApiKeySecretKey is the name of the secret in Secrets Manager.
Forge__Secrets__UseSecretsManager=false
Forge__Secrets__ApiKeySecretKey=Forge:Authentication:ApiKey

# --------------- gRPC / Kestrel ---------------
# Override listening ports (defaults come from appsettings.json Kestrel section).
# ASPNETCORE_URLS=https://localhost:7001;http://localhost:8080

# gRPC message size limits (bytes). Default: 4 MB.
# Forge__Grpc__MaxReceiveMessageSizeBytes=4194304
# Forge__Grpc__MaxSendMessageSizeBytes=4194304

# --------------- Resilience ---------------
Forge__Resilience__Enabled=true
Forge__Resilience__RetryCount=3
Forge__Resilience__RetryDelayMilliseconds=1000
Forge__Resilience__TimeoutSeconds=30

# --------------- Shutdown ---------------
# How long to drain in-flight gRPC calls before the process exits (seconds).
# Should match or be less than Kubernetes terminationGracePeriodSeconds.
Forge__Shutdown__TimeoutSeconds=30

# --------------- Observability ---------------
# OTLP exporter endpoint (OpenTelemetry Collector, Jaeger, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME={{ model.names.namespace }}

{{ if model.manifest.database != null -}}
# --------------- Database ---------------
# PostgreSQL connection string. In production, provision via AWS RDS and inject via Secrets Manager.
ConnectionStrings__Default=Host=localhost;Port=5432;Database={{ model.names.namespace | string.downcase }};Username=dev;Password=dev
{{ end -}}

{{ for module in model.selected_modules -}}
# --------------- Genesis: {{ module.name }} ---------------
# Configure {{ module.package_name }} per its README.
# {{ module.name | string.upcase }}__CONFIG_KEY=value
{{ end -}}

# --------------- AWS (local dev) ---------------
# For local development, set these to point to LocalStack or a dev AWS account.
AWS_REGION=ap-south-1
# AWS_ENDPOINT_URL=http://localhost:4566   # LocalStack
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local
