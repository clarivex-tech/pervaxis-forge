using Microsoft.AspNetCore.Mvc.Testing;
using Microsoft.Extensions.Configuration;
using Microsoft.Extensions.DependencyInjection;

namespace {{ model.names.namespace }}.Tests;

// WebApplicationFactory base class — overrides DI registrations and provides a pre-wired
// HttpClient so every test class can focus on assertions.
public abstract class TestBase : IAsyncLifetime
{
    private WebApplicationFactory<Program> _factory = null!;

    protected HttpClient Client { get; private set; } = null!;

    public Task InitializeAsync()
    {
        _factory = new WebApplicationFactory<Program>()
            .WithWebHostBuilder(host =>
            {
                host.UseEnvironment("Test");
                host.ConfigureAppConfiguration((_, config) =>
                    config.AddJsonFile("appsettings.Test.json", optional: false, reloadOnChange: false));
                host.ConfigureServices(services =>
                {
                    ConfigureTestServices(services);
                });
            });

        Client = _factory.CreateClient();
        return Task.CompletedTask;
    }

    public async Task DisposeAsync()
    {
        Client.Dispose();
        await _factory.DisposeAsync().ConfigureAwait(false);
    }

    // Override in derived test classes to swap in mocks
    protected virtual void ConfigureTestServices(IServiceCollection services) { }
}
