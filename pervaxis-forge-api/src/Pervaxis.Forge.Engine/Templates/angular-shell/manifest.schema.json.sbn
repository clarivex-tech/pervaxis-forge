{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pervaxis Forge Manifest",
  "description": "Schema for the Pervaxis Forge generated service manifest",
  "type": "object",
  "required": ["product", "verticalSlug", "serviceName", "serviceType", "componentPrefix", "canvasModules"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "product": {
      "type": "string",
      "description": "Product name used as the npm package scope",
      "minLength": 1
    },
    "verticalSlug": {
      "type": "string",
      "description": "Vertical identifier in kebab-case",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "serviceName": {
      "type": "string",
      "description": "Service name used as the Nx project key",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "serviceType": {
      "type": "string",
      "description": "Type of service generated by Forge",
      "enum": ["AngularShell", "AngularMonolith", "DotNetApi", "GrpcService"]
    },
    "componentPrefix": {
      "type": "string",
      "description": "Angular component selector prefix",
      "pattern": "^[a-z]{2,4}$"
    },
    "canvasModules": {
      "type": "array",
      "description": "List of Pervaxis Canvas modules integrated into this service",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
