import { HttpInterceptorFn } from '@angular/common/http';

// TODO: Inject auth service to retrieve the actual token
export const authInterceptor: HttpInterceptorFn = (req, next) => {
  const token = ''; // Replace with auth service token retrieval

  if (token) {
    const cloned = req.clone({
      setHeaders: {
        Authorization: `Bearer ${token}`
      }
    });
    return next(cloned);
  }

  return next(req);
};
