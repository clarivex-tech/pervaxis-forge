import { appConfig } from './app.config';

describe('appConfig', () => {
  it('should have a non-empty providers array', () => {
    expect(appConfig.providers).toBeDefined();
    expect(appConfig.providers.length).toBeGreaterThan(0);
  });

  it('should include router and HTTP client providers', () => {
    const providerStrings = appConfig.providers.map(p => JSON.stringify(p));
    const allProviders = providerStrings.join(' ');

    // Verify that providers are registered (router and HTTP are provided via factory functions)
    expect(appConfig.providers.length).toBeGreaterThanOrEqual(3);
  });
});
