/* Global styles for {{ model.manifest.service_name }}
 * Generated by Pervaxis Forge
 */

/* CSS Reset */
*,
*::before,
*::after {
  box-sizing: border-box;
}

* {
  margin: 0;
  padding: 0;
}

/* Design Tokens */
:root {
  --pvx-color-primary: #1a73e8;
  --pvx-color-primary-dark: #1557b0;
  --pvx-color-text: #202124;
  --pvx-color-text-secondary: #5f6368;
  --pvx-color-background: #ffffff;
  --pvx-color-surface: #f8f9fa;
  --pvx-color-border: #dadce0;
  --pvx-color-error: #d93025;

  --pvx-font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  --pvx-font-size-base: 16px;

  --pvx-spacing-xs: 4px;
  --pvx-spacing-sm: 8px;
  --pvx-spacing-md: 16px;
  --pvx-spacing-lg: 24px;
  --pvx-spacing-xl: 32px;

  --pvx-border-radius: 4px;
  --pvx-border-radius-lg: 8px;
}

/* Body Defaults */
html,
body {
  height: 100%;
}

body {
  font-family: var(--pvx-font-family);
  font-size: var(--pvx-font-size-base);
  line-height: 1.5;
  color: var(--pvx-color-text);
  background-color: var(--pvx-color-background);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
