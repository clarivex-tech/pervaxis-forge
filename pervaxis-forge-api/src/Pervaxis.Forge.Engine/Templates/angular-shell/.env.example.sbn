# Environment Variables — {{ model.manifest.service_name }}
# Copy this file to .env.local and fill in the values for local development.
# These values are used by the Angular environment files (src/environments/).

# API base URL for local development
API_URL=http://localhost:3000/api

# Canvas Auth configuration
CANVAS_AUTH_ISSUER=https://auth.pervaxis.dev
CANVAS_AUTH_CLIENT_ID=your-client-id-here
CANVAS_AUTH_REDIRECT_URI=http://localhost:4200/callback

# Feature flags (optional)
FEATURE_ANALYTICS_ENABLED=false
FEATURE_NOTIFICATIONS_ENABLED=false
